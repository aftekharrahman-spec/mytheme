<section class="zv-product-main" id="zv-product-section">
  <div class="zv-container">
    <!-- Clean Minimalist Breadcrumb -->
    <nav class="zv-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="zv-bc-sep">/</span>
      <a href="/collections/all">Menswear</a>
      <span class="zv-bc-sep">/</span>
      <span class="zv-bc-current">{{ product.title | default: "Signature Vintage Henley" }}</span>
    </nav>

    <div class="zv-product-grid">
      <!-- Media Gallery Column -->
      <div class="zv-gallery-sticky">
        <div class="zv-gallery-box">
          <!-- Main Hero Image Stage -->
          <div class="zv-main-stage" id="zv-main-stage">
            <!-- Badges -->
            <div class="zv-stage-badges">
              <span class="zv-badge-best">🔥 BESTSELLER</span>
              <span class="zv-badge-discount">40% OFF</span>
            </div>

            <!-- Fullscreen Lightbox Button -->
            <button type="button" class="zv-stage-zoom" onclick="openLightbox()" aria-label="Open Fullscreen View">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Zoom">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>

            <!-- Navigation Arrows -->
            <button type="button" class="zv-stage-nav zv-nav-prev" onclick="prevGalleryImage()" aria-label="Previous Image">‹</button>
            <button type="button" class="zv-stage-nav zv-nav-next" onclick="nextGalleryImage()" aria-label="Next Image">›</button>

            <!-- Main Image -->
            <div class="zv-stage-img-wrap" id="zv-stage-img-wrap">
              {%- if product.featured_image -%}
                <img id="zv-main-img" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}">
              {%- else -%}
                <img id="zv-main-img" src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}" alt="Zadavibe Product" onerror="this.src='{{ 'zadavibe-model-hero.jpg' | asset_url }}'">
              {%- endif -%}
            </div>

            <!-- Counter Chip -->
            <div class="zv-stage-counter">
              <span id="zv-img-cur">1</span> / <span id="zv-img-tot">{% if product.images.size > 0 %}{{ product.images.size }}{% else %}2{% endif %}</span>
            </div>
          </div>

          <!-- Thumbnails Row (Cleanly Situated Underneath Main Image) -->
          <div class="zv-thumbs-row" id="zv-thumbs-row">
            {%- if product.images.size > 0 -%}
              {%- for image in product.images -%}
                <button
                  type="button"
                  class="zv-thumb-item{% if forloop.first %} active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  data-full-src="{{ image | image_url: width: 1400 }}"
                  onclick="selectGalleryImage({{ forloop.index0 }}, '{{ image | image_url: width: 1200 }}', this)"
                  aria-label="View product image {{ forloop.index }}"
                >
                  <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">
                </button>
              {%- endfor -%}
            {%- else -%}
              <button
                type="button"
                class="zv-thumb-item active"
                data-index="0"
                data-full-src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}"
                onclick="selectGalleryImage(0, '{{ 'zadavibe-product-shirt.jpg' | asset_url }}', this)"
                aria-label="View shirt front"
              >
                <img src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}" alt="Shirt Front">
              </button>
              <button
                type="button"
                class="zv-thumb-item"
                data-index="1"
                data-full-src="{{ 'zadavibe-model-hero.jpg' | asset_url }}"
                onclick="selectGalleryImage(1, '{{ 'zadavibe-model-hero.jpg' | asset_url }}', this)"
                aria-label="View model fit"
              >
                <img src="{{ 'zadavibe-model-hero.jpg' | asset_url }}" alt="Model Fit">
              </button>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Buy Box Info Column -->
      <div class="zv-product-info">
        <!-- Eyebrow Tag -->
        <div class="zv-brand-eyebrow">ZADAVIBE • LUXURY MENSWEAR DUBAI</div>

        <!-- Title -->
        <h1 class="zv-product-title">
          {{ product.title | default: "Zadavibe Signature Vintage Lace-Up Ribbed Henley" }}
        </h1>

        <!-- Rating & Real-time Live Viewers -->
        <div class="zv-meta-row">
          <div class="zv-stars-group">
            <span class="zv-stars">★★★★★</span>
            <span class="zv-rating-text">4.9 (1,280+ Reviews)</span>
          </div>
          <span class="zv-meta-sep">•</span>
          <div class="zv-live-inline">
            <span class="zv-live-dot"></span>
            <span><strong id="zv-live-viewers-count">34</strong> men viewing now</span>
          </div>
        </div>

        <!-- Clean Pricing Row -->
        <div class="zv-pricing-row">
          <span class="zv-price-current" id="zv-display-price">
            {%- if product.selected_or_first_available_variant.price -%}
              {{ product.selected_or_first_available_variant.price | money }}
            {%- elsif product.price -%}
              {{ product.price | money }}
            {%- else -%}
              AED 149.00
            {%- endif -%}
          </span>
          <span class="zv-price-compare" id="zv-display-compare">
            {%- if product.selected_or_first_available_variant.compare_at_price -%}
              {{ product.selected_or_first_available_variant.compare_at_price | money }}
            {%- elsif product.compare_at_price -%}
              {{ product.compare_at_price | money }}
            {%- else -%}
              AED 249.00
            {%- endif -%}
          </span>
          <span class="zv-discount-badge">SAVE 40%</span>
        </div>

        <!-- UAE Delivery Notice -->
        <div class="zv-uae-delivery-strip">
          <span class="zv-strip-icon">🚚</span>
          <span><strong>Free Express UAE Delivery</strong> (Orders over AED 150) • <strong>Cash on Delivery (COD)</strong></span>
        </div>

        <!-- Countdown Timer -->
        <div class="zv-timer-strip">
          <span class="zv-timer-icon">⚡</span>
          <span>Order in <strong id="zv-cd-timer" class="zv-timer-tag">03h 42m 18s</strong> for <strong>Next-Day Dispatch across UAE</strong></span>
        </div>

        <!-- Dynamic Product Options (Sizes, Colors from CJ Dropshipping / Shopify) -->
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="zv-variant-group" data-option-index="{{ forloop.index0 }}">
              <div class="zv-variant-label-bar">
                <span class="zv-variant-label">
                  SELECT {{ option.name | upcase }}: <strong class="zv-selected-val" id="zv-val-{{ forloop.index0 }}">{{ option.selected_value }}</strong>
                </span>
                {%- if option.name contains 'Size' or option.name contains 'size' or option.name contains 'SIZE' -%}
                  <button type="button" class="zv-size-link" onclick="openSizeGuide()">
                    📏 Size Guide
                  </button>
                {%- endif -%}
              </div>

              <div class="zv-size-pills">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="zv-size-pill{% if option.selected_value == value %} active{% endif %}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-value="{{ value | escape }}"
                    onclick="selectVariantOption({{ forloop.parentloop.index0 }}, '{{ value | escape }}', this)"
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback demo sizes for preview mode -->
          <div class="zv-variant-group">
            <div class="zv-variant-label-bar">
              <span class="zv-variant-label">SELECT SIZE: <strong class="zv-selected-val" id="zv-val-0">M</strong></span>
              <button type="button" class="zv-size-link" onclick="openSizeGuide()">
                📏 Size Guide
              </button>
            </div>
            <div class="zv-size-pills">
              <button type="button" class="zv-size-pill" onclick="selectFallbackSize('S', this)">S</button>
              <button type="button" class="zv-size-pill active" onclick="selectFallbackSize('M', this)">M</button>
              <button type="button" class="zv-size-pill" onclick="selectFallbackSize('L', this)">L</button>
              <button type="button" class="zv-size-pill" onclick="selectFallbackSize('XL', this)">XL</button>
              <button type="button" class="zv-size-pill" onclick="selectFallbackSize('XXL', this)">XXL</button>
            </div>
          </div>
        {%- endunless -%}

        <!-- Scarcity Note -->
        <div class="zv-scarcity-line">
          🔥 <span>Only <strong id="zv-stock-number">6</strong> left in stock for size <strong id="zv-stock-size-label">M</strong> — selling fast</span>
        </div>

        <!-- Add To Cart Form -->
        <form method="post" action="/cart/add" id="zv-add-form" class="zv-form-container">
          <input type="hidden" name="id" id="zv-variant-id-input" value="{{ product.selected_or_first_available_variant.id | default: 1 }}">

          <!-- Quantity Stepper & Add To Cart Row -->
          <div class="zv-actions-row">
            <div class="zv-stepper-box">
              <button type="button" class="zv-step-btn" onclick="updateQuantity(-1)" aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" id="zv-cart-quantity" value="1" min="1" max="10" readonly aria-label="Quantity">
              <button type="button" class="zv-step-btn" onclick="updateQuantity(1)" aria-label="Increase quantity">+</button>
            </div>

            <button type="submit" class="zv-btn-atc" id="zv-atc-button"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
              <span class="zv-atc-label">{% if product.selected_or_first_available_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</span>
              <span class="zv-atc-sep">•</span>
              <span id="zv-btn-price" class="zv-atc-val">
                {%- if product.selected_or_first_available_variant.price -%}
                  {{ product.selected_or_first_available_variant.price | money }}
                {%- elsif product.price -%}
                  {{ product.price | money }}
                {%- else -%}
                  AED 149.00
                {%- endif -%}
              </span>
            </button>
          </div>

          <!-- Express Cash On Delivery Button -->
          <button type="button" class="zv-btn-cod" onclick="expressCheckout()">
            ⚡ ORDER WITH CASH ON DELIVERY (COD)
          </button>
        </form>

        <!-- Trust Features Grid (Minimalist & Clean) -->
        <div class="zv-trust-grid">
          <div class="zv-trust-card">
            <span class="zv-tc-icon">⚡</span>
            <div>
              <strong>1–2 Days Express Dispatch</strong>
              <p>Delivery across Dubai & UAE Emirates</p>
            </div>
          </div>
          <div class="zv-trust-card">
            <span class="zv-tc-icon">💵</span>
            <div>
              <strong>Cash on Delivery (COD)</strong>
              <p>Inspect & pay at your doorstep</p>
            </div>
          </div>
          <div class="zv-trust-card">
            <span class="zv-tc-icon">🔄</span>
            <div>
              <strong>14-Day Free Exchange</strong>
              <p>Hassle-free WhatsApp courier swap</p>
            </div>
          </div>
          <div class="zv-trust-card">
            <span class="zv-tc-icon">🛡️</span>
            <div>
              <strong>100% Organic Ribbed Cotton</strong>
              <p>Anti-shrink & colorfast guarantee</p>
            </div>
          </div>
        </div>

        <!-- Safe Checkout Payment Logos -->
        <div class="zv-pay-bar">
          <span class="zv-pay-title">GUARANTEED SAFE CHECKOUT:</span>
          <div class="zv-pay-icons">
            <!-- Visa -->
            <svg viewBox="0 0 38 24" width="36" height="22" role="img" aria-label="Visa"><rect width="38" height="24" rx="4" fill="#1434CB"/><path d="M15.4 16.5h-2.3l1.4-9h2.3l-1.4 9zm9.2-8.8c-.5-.2-1.2-.4-2.1-.4-2.3 0-4 1.2-4 3 0 1.3 1.2 2 2.1 2.4.9.5 1.2.8 1.2 1.2 0 .6-.8.9-1.5.9-.9 0-1.5-.2-2.3-.5l-.3-.2-.3 2c.6.3 1.6.5 2.7.5 2.5 0 4.1-1.2 4.1-3.1 0-1-.6-1.8-2-2.4-.8-.4-1.3-.7-1.3-1.2 0-.4.5-.8 1.4-.8.8 0 1.4.2 1.8.4l.2.1.4-1.8zm6.5 4.3l1-2.8.6 2.8h-1.6zm2.4 4.5h2.1l-1.8-9h-2c-.6 0-1.1.2-1.3.8l-3.8 8.2h2.4l.5-1.4h3l.1 1.4zm-12.7-9l-1.8 6.1-.2-1-.7-3.6c-.1-.7-.6-1.5-1.3-1.5H12l-.2.8c.8.2 1.7.5 2.3.8.3.2.5.6.6 1.1l1.8 6.7h2.4l3.6-9.4h-2.1z" fill="#FFF"/></svg>
            <!-- Mastercard -->
            <svg viewBox="0 0 38 24" width="36" height="22" role="img" aria-label="Mastercard"><rect width="38" height="24" rx="4" fill="#0A0A0A"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8a7 7 0 010 10.4 7 7 0 010-10.4z" fill="#FF5F00"/></svg>
            <!-- Amex -->
            <svg viewBox="0 0 38 24" width="36" height="22" role="img" aria-label="American Express"><rect width="38" height="24" rx="4" fill="#0077A6"/><path d="M7 16h3.4l.7-1.7h3.6l.7 1.7H19l-3.5-8h-3.9L7 16zm5.8-3.4l1.1-2.7 1.1 2.7h-2.2zM20.2 8v8h5.8v-1.7h-3.8v-1.5h3.6v-1.7h-3.6V9.7H26V8h-5.8zm7.3 0l1.9 4-1.9 4h2.2l.9-1.9.9 1.9h2.2l-1.9-4 1.9-4h-2.2l-.9 1.9-.9-1.9h-2.2z" fill="#FFF"/></svg>
            <!-- Apple Pay -->
            <svg viewBox="0 0 38 24" width="36" height="22" role="img" aria-label="Apple Pay"><rect width="38" height="24" rx="4" fill="#000"/><path d="M15.2 10.8c-.3.4-.8.7-1.3.6-.1-.5.1-1 .4-1.3.3-.4.8-.6 1.3-.6.1.5-.1 1-.4 1.3zm.4 1.4c-.7 0-1.3.4-1.6.4-.3 0-.8-.4-1.4-.4-.7 0-1.4.4-1.8 1.1-.7 1.3-.2 3.2.5 4.3.4.5.8 1.1 1.4 1.1.5 0 .8-.4 1.4-.4.6 0 .8.4 1.4.4.6 0 1-.5 1.4-1.1.4-.6.6-1.2.6-1.2s-.7-.3-.7-1.2c0-.8.6-1.2.6-1.2-.4-.6-1-.7-1.2-.7zm4.2-2.7h1.4v7.3h-1.4V9.5zm4.8 2.2c1.1 0 1.9.8 1.9 2s-.8 2-1.9 2c-.6 0-1.1-.2-1.4-.6v2.3h-1.3V11.8h1.2v.5c.3-.4.8-.6 1.5-.6zm-.3 3c.6 0 1-.4 1-1s-.4-1-1-1-.9.4-.9 1 .3 1 .9 1zm6.7-.8c0 1.2-.9 2-2.2 2-1.2 0-2.1-.8-2.1-2s.9-2 2.1-2c1.3 0 2.2.8 2.2 2zm-1.3 0c0-.6-.4-1-1-1s-.9.4-.9 1 .4 1 .9 1c.5 0 1-.4 1-1z" fill="#FFF"/></svg>
            <!-- Google Pay -->
            <svg viewBox="0 0 38 24" width="36" height="22" role="img" aria-label="Google Pay"><rect width="38" height="24" rx="4" fill="#FFF" stroke="#E5E7EB"/><path d="M15.4 12.1v3.4h-1.2V7.7h3.1c.8 0 1.5.3 2 .8.5.5.8 1.2.8 2s-.3 1.5-.8 2c-.5.5-1.2.8-2 .8h-1.9zm0-3.3v2.3h1.9c.5 0 .9-.2 1.2-.5.3-.3.5-.7.5-1.2 0-.4-.2-.8-.5-1.1-.3-.3-.7-.5-1.2-.5h-1.9zm8.5 2.1c.8 0 1.4.2 1.9.6.5.4.7 1 .7 1.7v3h-1.1v-.7c-.3.5-.8.9-1.5.9-.6 0-1.1-.2-1.5-.5-.4-.3-.6-.8-.6-1.3 0-.6.2-1 .6-1.3.4-.3 1-.5 1.7-.5.6 0 1.1.1 1.5.3v-.2c0-.4-.1-.7-.4-.9-.3-.2-.7-.4-1.1-.4-.6 0-1.1.3-1.4.8l-1.1-.7c.5-.8 1.4-1.1 2.3-1.1zm-1.8 3.5c0 .3.1.5.3.7.2.2.5.3.8.3.4 0 .8-.2 1.1-.5.3-.3.5-.7.5-1.1-.3-.2-.8-.3-1.3-.3-.4 0-.8.1-1 .3-.3.1-.4.4-.4.6zm6.3-1.9l1.4 3.4 1.4-3.4h1.3l-2.1 4.8-1.2 2.7h-1.2l.9-1.9-2-5.6h1.5z" fill="#3C4043"/><path d="M10.8 12.1c0-.2 0-.4-.1-.6H7v1.4h2.1c-.1.5-.4 1-.8 1.3v1.1h1.3c.8-.7 1.2-1.9 1.2-3.2z" fill="#4285F4"/><path d="M7 16c1.1 0 2-.4 2.7-1.1l-1.3-1.1c-.4.3-.9.4-1.4.4-.8 0-1.5-.5-1.8-1.3H3.8v1.1C4.5 15.3 5.7 16 7 16z" fill="#34A853"/><path d="M5.2 13c-.1-.3-.1-.6-.1-.9 0-.3 0-.6.1-.9V10H3.8C3.3 11 3.3 12.2 3.8 13.2l1.4-.2z" fill="#FBBC04"/><path d="M7 8.7c.6 0 1.2.2 1.6.6l1.2-1.2C9 7.3 8 6.9 7 6.9c-1.3 0-2.5.7-3.2 1.9l1.4 1.1c.3-.7 1-1.2 1.8-1.2z" fill="#EA4335"/></svg>
          </div>
        </div>

        <!-- Clean Accordions -->
        <div class="zv-accordions">
          <!-- Item 1: Details -->
          <div class="zv-acc-box">
            <button type="button" class="zv-acc-head active" onclick="toggleAcc(this)">
              <span>👔 Silhouette & Highlights</span>
              <span class="zv-acc-sym">−</span>
            </button>
            <div class="zv-acc-body open">
              <div class="zv-acc-content">
                {%- if product.description != blank -%}
                  <div class="zv-rich-text">{{ product.description }}</div>
                {%- else -%}
                  <p>Tailored athletic cut engineered to naturally accentuate shoulders and chest while maintaining comfortable breathability.</p>
                {%- endif -%}
                <ul class="zv-bullet-list">
                  <li>Hand-braided micro-cord lace placket with reinforced eyelets</li>
                  <li>260 GSM heavyweight micro-ribbed knit for structured drape</li>
                  <li>Pre-shrunk cotton fabric that retains fit after washing</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Item 2: Fabric & Care -->
          <div class="zv-acc-box">
            <button type="button" class="zv-acc-head" onclick="toggleAcc(this)">
              <span>🧵 Fabric Engineering & Care</span>
              <span class="zv-acc-sym">+</span>
            </button>
            <div class="zv-acc-body">
              <div class="zv-acc-content">
                <p>100% sustainably harvested organic cotton. Engineered with micro-air channels to keep skin cool in high temperatures.</p>
                <ul class="zv-bullet-list">
                  <li>Machine wash cold (30°C) with similar colors</li>
                  <li>Tumble dry low or hang dry to preserve ribbed elasticity</li>
                  <li>Do not bleach; warm iron inside-out if desired</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Item 3: Shipping & Returns -->
          <div class="zv-acc-box">
            <button type="button" class="zv-acc-head" onclick="toggleAcc(this)">
              <span>✈️ UAE Shipping & 14-Day Exchanges</span>
              <span class="zv-acc-sym">+</span>
            </button>
            <div class="zv-acc-body">
              <div class="zv-acc-content">
                <p>Fast and reliable dispatch across Dubai, Abu Dhabi, Sharjah, Ajman, RAK, Fujairah, and UAQ.</p>
                <ul class="zv-bullet-list">
                  <li>Next-day express delivery for Dubai and Sharjah</li>
                  <li>1–2 business days for Abu Dhabi and other Emirates</li>
                  <li>Cash on Delivery (COD) supported at doorstep</li>
                  <li>Need a size swap? Quick WhatsApp exchange service</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Size Guide Modal -->
<div class="zv-modal-backdrop" id="zv-size-modal" onclick="closeSizeGuide(event)">
  <div class="zv-modal-window" onclick="event.stopPropagation()">
    <div class="zv-modal-top">
      <h3 class="zv-modal-h3">📏 MEN'S SIZE & FIT GUIDE</h3>
      <button type="button" class="zv-modal-x" onclick="closeSizeGuide()" aria-label="Close modal">✕</button>
    </div>
    <div class="zv-modal-scroll">
      <p class="zv-guide-tip">
        <strong>Fit Recommendation:</strong> Athletic tailored silhouette. If you prefer a relaxed or bohemian drape, order one size larger.
      </p>
      <div class="zv-table-wrap">
        <table class="zv-tbl">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest (CM)</th>
              <th>Chest (Inches)</th>
              <th>Length (CM)</th>
              <th>Shoulder (CM)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong>S</strong></td><td>96 - 101</td><td>38" - 40"</td><td>70</td><td>44</td></tr>
            <tr class="zv-row-active"><td><strong>M (Popular)</strong></td><td>102 - 107</td><td>40" - 42"</td><td>72</td><td>46</td></tr>
            <tr><td><strong>L</strong></td><td>108 - 113</td><td>42" - 44"</td><td>74</td><td>48</td></tr>
            <tr><td><strong>XL</strong></td><td>114 - 119</td><td>45" - 47"</td><td>76</td><td>50</td></tr>
            <tr><td><strong>2XL</strong></td><td>120 - 126</td><td>47" - 49"</td><td>78</td><td>52</td></tr>
            <tr><td><strong>3XL</strong></td><td>127 - 134</td><td>50" - 52"</td><td>80</td><td>54</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Fullscreen Lightbox Modal -->
<div class="zv-lightbox-wrap" id="zv-lightbox-modal" onclick="closeLightbox(event)">
  <button type="button" class="zv-lb-x" onclick="closeLightbox()" aria-label="Close fullscreen">✕</button>
  <button type="button" class="zv-lb-btn zv-lb-prev" onclick="lbPrev(event)" aria-label="Previous image">‹</button>
  <button type="button" class="zv-lb-btn zv-lb-next" onclick="lbNext(event)" aria-label="Next image">›</button>
  <div class="zv-lb-view" onclick="event.stopPropagation()">
    {% # theme-check-disable RemoteAsset %}
    <img id="zv-lb-img" src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}" alt="Fullscreen view">
    {% # theme-check-enable RemoteAsset %}
  </div>
</div>

<!-- Sticky Add To Cart Bar -->
<div class="zv-sticky-atc" id="zv-sticky-bar">
  <div class="zv-sticky-left">
    <div class="zv-sticky-thumb">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}">
      {%- else -%}
        <img src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}" alt="Thumb">
      {%- endif -%}
    </div>
    <div class="zv-sticky-details">
      <div class="zv-sticky-title">{{ product.title | default: "Zadavibe Signature Henley" }}</div>
      <div class="zv-sticky-meta">
        <span class="zv-sticky-price" id="zv-sticky-price-text">
          {%- if product.selected_or_first_available_variant.price -%}
            {{ product.selected_or_first_available_variant.price | money }}
          {%- elsif product.price -%}
            {{ product.price | money }}
          {%- else -%}
            AED 149.00
          {%- endif -%}
        </span>
        <span class="zv-sticky-size">Size: <strong id="zv-sticky-size-val">M</strong></span>
      </div>
    </div>
  </div>
  <div>
    <button type="button" class="zv-btn-atc-sticky" onclick="document.getElementById('zv-add-form').submit()">
      ADD TO CART
    </button>
  </div>
</div>

<!-- Raw Variants JSON -->
<script id="zv-variants-data" type="application/json">
  {{ product.variants | json }}
</script>

<style>
  /* ==========================================================================
     ZadaVibe Modern Luxury Product Page CSS (100% Responsive Desktop & Mobile)
     ========================================================================== */
  .zv-product-main {
    padding: 24px 0 60px;
    background: #ffffff;
  }

  /* Breadcrumb */
  .zv-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: #88928a;
    margin-bottom: 20px;
    font-weight: 500;
  }
  .zv-breadcrumb a {
    color: #555f56;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .zv-breadcrumb a:hover {
    color: var(--zv-primary);
  }
  .zv-bc-sep {
    color: #cbd5e1;
  }
  .zv-bc-current {
    color: var(--zv-text);
    font-weight: 600;
    max-width: 280px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 2-Column Grid */
  .zv-product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: flex-start;
  }

  /* Gallery Sticky Left Column */
  .zv-gallery-sticky {
    position: sticky;
    top: 90px;
  }

  .zv-gallery-box {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Main Stage Container */
  .zv-main-stage {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #f4f6f4;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    user-select: none;
  }

  .zv-stage-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: crosshair;
  }

  .zv-stage-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.15s ease-out;
    transform-origin: center center;
    will-change: transform;
  }

  /* Floating Badges */
  .zv-stage-badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 4;
    pointer-events: none;
  }
  .zv-badge-best {
    background: #2d3b31;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 5px 10px;
    border-radius: 20px;
  }
  .zv-badge-discount {
    background: #c85a32;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 5px 10px;
    border-radius: 20px;
  }

  /* Zoom Icon */
  .zv-stage-zoom {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a241c;
    cursor: pointer;
    z-index: 4;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: transform 0.2s ease;
  }
  .zv-stage-zoom:hover {
    transform: scale(1.08);
  }

  /* Navigation Arrows */
  .zv-stage-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(6px);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: #1a241c;
    cursor: pointer;
    z-index: 4;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: all 0.2s ease;
    opacity: 0;
  }
  .zv-main-stage:hover .zv-stage-nav {
    opacity: 1;
  }
  .zv-nav-prev { left: 12px; }
  .zv-nav-next { right: 12px; }
  .zv-stage-nav:hover {
    background: #ffffff;
    transform: translateY(-50%) scale(1.08);
  }

  /* Counter Chip */
  .zv-stage-counter {
    position: absolute;
    bottom: 12px;
    right: 14px;
    background: rgba(0,0,0,0.6);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 12px;
    backdrop-filter: blur(4px);
    z-index: 4;
  }

  /* Thumbnails Underneath Main Image */
  .zv-thumbs-row {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .zv-thumbs-row::-webkit-scrollbar {
    display: none;
  }

  .zv-thumb-item {
    width: 72px;
    height: 86px;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    flex-shrink: 0;
    border: 2px solid transparent;
    background: #f1f3f1;
    padding: 0;
    transition: all 0.2s ease;
  }
  .zv-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .zv-thumb-item.active {
    border-color: #2d3b31;
    box-shadow: 0 0 0 1px #2d3b31;
  }

  /* Buy Box Info Styling */
  .zv-product-info {
    display: flex;
    flex-direction: column;
    padding-left: 10px;
  }

  .zv-brand-eyebrow {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #6b776e;
    margin-bottom: 8px;
  }

  .zv-product-title {
    font-family: var(--zv-font-heading);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 800;
    color: var(--zv-text);
    line-height: 1.2;
    margin: 0 0 12px;
  }

  /* Rating and Live Viewers */
  .zv-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    margin-bottom: 16px;
  }
  .zv-stars-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .zv-stars {
    color: #f59e0b;
    letter-spacing: 1px;
    font-size: 0.95rem;
  }
  .zv-rating-text {
    font-weight: 600;
    color: #4b5563;
  }
  .zv-meta-sep {
    color: #cbd5e1;
  }
  .zv-live-inline {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #166534;
    font-weight: 600;
    background: #f0fdf4;
    padding: 2px 8px;
    border-radius: 12px;
    border: 1px solid #bbf7d0;
    font-size: 0.78rem;
  }
  .zv-live-dot {
    width: 6px;
    height: 6px;
    background: #16a34a;
    border-radius: 50%;
  }

  /* Pricing Row */
  .zv-pricing-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .zv-price-current {
    font-size: 1.85rem;
    font-weight: 800;
    color: #2d3b31;
    font-family: var(--zv-font-heading);
  }
  .zv-price-compare {
    font-size: 1.15rem;
    text-decoration: line-through;
    color: #94a3b8;
  }
  .zv-discount-badge {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 14px;
    letter-spacing: 0.04em;
  }

  /* Delivery Notice Strip */
  .zv-uae-delivery-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f8faf9;
    border: 1px solid #e2e8e4;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.82rem;
    color: #2d3b31;
    margin-bottom: 12px;
  }
  .zv-strip-icon {
    font-size: 1.1rem;
  }

  /* Timer Strip */
  .zv-timer-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: #854d0e;
    background: #fefce8;
    border: 1px solid #fef08a;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 20px;
  }
  .zv-timer-tag {
    background: #ca8a04;
    color: #ffffff;
    padding: 1px 6px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.82rem;
  }

  /* Size Selector */
  .zv-variant-group {
    margin-bottom: 18px;
  }
  .zv-variant-label-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .zv-variant-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--zv-text);
  }
  .zv-selected-val {
    color: #2d3b31;
    font-weight: 800;
  }
  .zv-size-link {
    background: none;
    border: none;
    color: #2d3b31;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0;
  }

  .zv-size-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .zv-size-pill {
    border: 1.5px solid #d8ded9;
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    background: #ffffff;
    color: var(--zv-text);
    min-width: 48px;
    text-align: center;
    transition: all 0.2s ease;
  }
  .zv-size-pill:hover {
    border-color: #2d3b31;
  }
  .zv-size-pill.active {
    background: #2d3b31;
    color: #ffffff;
    border-color: #2d3b31;
  }

  /* Scarcity line */
  .zv-scarcity-line {
    font-size: 0.8rem;
    color: #b91c1c;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Actions Row */
  .zv-form-container {
    margin-bottom: 24px;
  }
  .zv-actions-row {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
  }

  /* Stepper */
  .zv-stepper-box {
    display: flex;
    align-items: center;
    border: 1.5px solid #d8ded9;
    border-radius: 8px;
    height: 50px;
    background: #ffffff;
    overflow: hidden;
    flex-shrink: 0;
  }
  .zv-step-btn {
    width: 40px;
    height: 100%;
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: #1a241c;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .zv-step-btn:hover {
    background: #f4f6f4;
  }
  .zv-stepper-box input {
    width: 36px;
    text-align: center;
    font-weight: 700;
    border: none;
    outline: none;
    font-size: 0.95rem;
    color: #1a241c;
    background: transparent;
  }

  /* Add To Cart Primary Button */
  .zv-btn-atc {
    flex: 1;
    height: 50px;
    background: #2d3b31;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(45, 59, 49, 0.25);
  }
  .zv-btn-atc:hover {
    background: #1e2820;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(45, 59, 49, 0.35);
  }
  .zv-atc-sep {
    opacity: 0.6;
  }

  /* Cash On Delivery Express Secondary Button */
  .zv-btn-cod {
    width: 100%;
    height: 48px;
    background: #f8faf9;
    color: #2d3b31;
    border: 1.5px solid #2d3b31;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 800;
    cursor: pointer;
    letter-spacing: 0.03em;
    transition: all 0.2s ease;
  }
  .zv-btn-cod:hover {
    background: #2d3b31;
    color: #ffffff;
  }

  /* Trust Cards Grid */
  .zv-trust-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 22px;
    padding-top: 14px;
    border-top: 1px solid #edf1ee;
  }
  .zv-trust-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .zv-tc-icon {
    font-size: 1.15rem;
    line-height: 1;
    margin-top: 2px;
  }
  .zv-trust-card strong {
    display: block;
    font-size: 0.82rem;
    color: var(--zv-text);
    margin-bottom: 1px;
  }
  .zv-trust-card p {
    font-size: 0.74rem;
    color: #64748b;
    margin: 0;
    line-height: 1.3;
  }

  /* Payment Bar */
  .zv-pay-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px 0;
    border-top: 1px solid #edf1ee;
    border-bottom: 1px solid #edf1ee;
    margin-bottom: 20px;
  }
  .zv-pay-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #64748b;
  }
  .zv-pay-icons {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Accordions */
  .zv-accordions {
    display: flex;
    flex-direction: column;
  }
  .zv-acc-box {
    border-bottom: 1px solid #edf1ee;
  }
  .zv-acc-head {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--zv-text);
    text-align: left;
  }
  .zv-acc-sym {
    font-size: 1.2rem;
    color: #64748b;
    font-weight: 300;
  }
  .zv-acc-body {
    display: none;
    padding-bottom: 16px;
    font-size: 0.86rem;
    color: #4b5563;
    line-height: 1.6;
  }
  .zv-acc-body.open {
    display: block;
  }
  .zv-bullet-list {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
  }
  .zv-bullet-list li {
    padding-left: 16px;
    position: relative;
    margin-bottom: 5px;
  }
  .zv-bullet-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #2d3b31;
    font-weight: bold;
  }

  /* Modal Backdrop */
  .zv-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(5px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .zv-modal-backdrop.active {
    display: flex;
  }
  .zv-modal-window {
    background: #ffffff;
    border-radius: 12px;
    width: 100%;
    max-width: 580px;
    padding: 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    animation: zvPopIn 0.2s ease-out;
  }
  @keyframes zvPopIn {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  .zv-modal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    border-bottom: 1px solid #edf1ee;
    padding-bottom: 10px;
  }
  .zv-modal-h3 {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    color: #1a241c;
  }
  .zv-modal-x {
    background: none;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    color: #64748b;
    padding: 4px;
  }
  .zv-guide-tip {
    font-size: 0.84rem;
    color: #4b5563;
    line-height: 1.5;
    background: #f8faf9;
    padding: 10px 14px;
    border-radius: 8px;
    border-left: 3px solid #2d3b31;
    margin-bottom: 14px;
  }
  .zv-table-wrap {
    overflow-x: auto;
  }
  .zv-tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
  }
  .zv-tbl th, .zv-tbl td {
    padding: 8px 10px;
    text-align: left;
    border-bottom: 1px solid #edf1ee;
  }
  .zv-tbl th {
    background: #f4f6f4;
    font-weight: 700;
    color: #2d3b31;
  }
  .zv-row-active {
    background: #f0fdf4;
  }

  /* Fullscreen Lightbox */
  .zv-lightbox-wrap {
    position: fixed;
    inset: 0;
    background: rgba(10, 15, 12, 0.95);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
  }
  .zv-lightbox-wrap.active {
    display: flex;
  }
  .zv-lb-x {
    position: absolute;
    top: 20px;
    right: 24px;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 2rem;
    cursor: pointer;
    z-index: 100001;
  }
  .zv-lb-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 1.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .zv-lb-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .zv-lb-prev { left: 20px; }
  .zv-lb-next { right: 20px; }
  .zv-lb-view {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .zv-lb-view img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 8px;
  }

  /* Sticky ATC Bar */
  .zv-sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    border-top: 1px solid #edf1ee;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 900;
    box-shadow: 0 -4px 16px rgba(0,0,0,0.08);
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .zv-sticky-atc.visible {
    transform: translateY(0);
  }
  .zv-sticky-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .zv-sticky-thumb {
    width: 48px;
    height: 54px;
    border-radius: 6px;
    overflow: hidden;
    background: #f4f6f4;
    flex-shrink: 0;
  }
  .zv-sticky-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zv-sticky-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--zv-text);
  }
  .zv-sticky-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
  }
  .zv-sticky-price {
    font-size: 0.85rem;
    font-weight: 800;
    color: #2d3b31;
  }
  .zv-sticky-size {
    font-size: 0.74rem;
    background: #edf1ee;
    padding: 1px 6px;
    border-radius: 4px;
    font-weight: 600;
  }
  .zv-btn-atc-sticky {
    height: 42px;
    padding: 0 24px;
    background: #2d3b31;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-weight: 800;
    font-size: 0.88rem;
    cursor: pointer;
  }

  /* ==========================================================================
     MOBILE RESPONSIVE BREAKPOINTS (360px - 990px)
     ========================================================================== */
  @media (max-width: 990px) {
    .zv-product-main {
      padding: 16px 0 40px;
    }

    .zv-product-grid {
      grid-template-columns: 1fr !important;
      gap: 24px;
    }

    .zv-gallery-sticky {
      position: static !important;
      top: auto !important;
    }

    .zv-stage-img-wrap {
      aspect-ratio: 1 / 1;
      max-height: 400px;
    }

    .zv-stage-nav {
      opacity: 1;
    }

    .zv-thumb-item {
      width: 60px;
      height: 72px;
    }

    .zv-product-info {
      padding-left: 0;
    }

    .zv-product-title {
      font-size: 1.45rem;
      margin-bottom: 8px;
    }

    .zv-pricing-row {
      margin-bottom: 12px;
    }

    .zv-price-current {
      font-size: 1.6rem;
    }

    .zv-size-pills {
      gap: 6px;
    }

    .zv-size-pill {
      flex: 1;
      min-width: 44px;
      padding: 9px 8px;
      font-size: 0.85rem;
    }

    .zv-actions-row {
      flex-direction: row;
      gap: 8px;
    }

    .zv-stepper-box {
      height: 46px;
    }

    .zv-btn-atc {
      height: 46px;
      font-size: 0.9rem;
    }

    .zv-btn-cod {
      height: 44px;
      font-size: 0.82rem;
    }

    .zv-trust-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .zv-sticky-atc {
      padding: 10px 16px;
    }
  }

  @media (max-width: 480px) {
    .zv-stage-img-wrap {
      max-height: 340px;
    }
    .zv-trust-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>

<script>
  const currencySymbol = 'AED ';
  let basePrice = {%- if product.selected_or_first_available_variant.price -%}{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}{%- elsif product.price -%}{{ product.price | divided_by: 100.0 }}{%- else -%}149.00{%- endif -%};
  
  let currentImageIndex = 0;
  const galleryThumbEls = document.querySelectorAll('.zv-thumb-item');
  const totalGalleryImages = galleryThumbEls.length;

  let productVariants = [];
  try {
    const rawVariants = document.getElementById('zv-variants-data');
    if (rawVariants && rawVariants.textContent) {
      productVariants = JSON.parse(rawVariants.textContent);
    }
  } catch (e) {
    console.warn('Could not parse variants JSON', e);
  }

  // Selected options state array
  const selectedOptionsState = [];
  {%- if product.options_with_values -%}
    {%- for option in product.options_with_values -%}
      selectedOptionsState[{{ forloop.index0 }}] = {{ option.selected_value | json }};
    {%- endfor -%}
  {%- endif -%}

  /* Smooth Pan Hover Magnifier (Desktop Only) */
  const stageWrap = document.getElementById('zv-stage-img-wrap');
  const mainImg = document.getElementById('zv-main-img');

  if (stageWrap && mainImg) {
    stageWrap.addEventListener('mousemove', function(e) {
      if (window.innerWidth < 990) return;
      const rect = stageWrap.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      mainImg.style.transformOrigin = `${x}% ${y}%`;
      mainImg.style.transform = 'scale(1.4)';
    });

    stageWrap.addEventListener('mouseleave', function() {
      mainImg.style.transformOrigin = 'center center';
      mainImg.style.transform = 'scale(1)';
    });
  }

  /* Mobile Touch Swipe Gesture */
  let touchStartX = 0;
  let touchEndX = 0;

  if (stageWrap) {
    stageWrap.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    stageWrap.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });
  }

  function handleSwipe() {
    const diff = touchEndX - touchStartX;
    if (Math.abs(diff) > 40) {
      if (diff < 0) {
        nextGalleryImage(); // Swipe left
      } else {
        prevGalleryImage(); // Swipe right
      }
    }
  }

  /* Gallery Selection */
  function selectGalleryImage(idx, src, thumbEl) {
    currentImageIndex = idx;
    if (mainImg) {
      mainImg.src = src;
    }
    document.querySelectorAll('.zv-thumb-item').forEach(t => t.classList.remove('active'));
    if (thumbEl) {
      thumbEl.classList.add('active');
      thumbEl.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }
    const curEl = document.getElementById('zv-img-cur');
    if (curEl) curEl.textContent = idx + 1;
  }

  function nextGalleryImage() {
    if (totalGalleryImages <= 1) return;
    let nextIdx = (currentImageIndex + 1) % totalGalleryImages;
    const target = galleryThumbEls[nextIdx];
    if (target) target.click();
  }

  function prevGalleryImage() {
    if (totalGalleryImages <= 1) return;
    let prevIdx = (currentImageIndex - 1 + totalGalleryImages) % totalGalleryImages;
    const target = galleryThumbEls[prevIdx];
    if (target) target.click();
  }

  /* Lightbox */
  function openLightbox() {
    const modal = document.getElementById('zv-lightbox-modal');
    const lbImg = document.getElementById('zv-lb-img');
    const curThumb = galleryThumbEls[currentImageIndex];
    if (modal && lbImg && curThumb) {
      lbImg.src = curThumb.getAttribute('data-full-src') || mainImg.src;
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLightbox(e) {
    const modal = document.getElementById('zv-lightbox-modal');
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  function lbNext(e) {
    if (e) e.stopPropagation();
    nextGalleryImage();
    const lbImg = document.getElementById('zv-lb-img');
    const curThumb = galleryThumbEls[currentImageIndex];
    if (lbImg && curThumb) {
      lbImg.src = curThumb.getAttribute('data-full-src') || mainImg.src;
    }
  }

  function lbPrev(e) {
    if (e) e.stopPropagation();
    prevGalleryImage();
    const lbImg = document.getElementById('zv-lb-img');
    const curThumb = galleryThumbEls[currentImageIndex];
    if (lbImg && curThumb) {
      lbImg.src = curThumb.getAttribute('data-full-src') || mainImg.src;
    }
  }

  /* Size Guide */
  function openSizeGuide() {
    const modal = document.getElementById('zv-size-modal');
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeSizeGuide() {
    const modal = document.getElementById('zv-size-modal');
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  /* Accordions */
  function toggleAcc(btn) {
    const body = btn.nextElementSibling;
    const sym = btn.querySelector('.zv-acc-sym');
    const isOpen = body.classList.contains('open');

    if (isOpen) {
      body.classList.remove('open');
      btn.classList.remove('active');
      if (sym) sym.textContent = '+';
    } else {
      body.classList.add('open');
      btn.classList.add('active');
      if (sym) sym.textContent = '−';
    }
  }

  /* Dynamic Variants Selection (CJ Dropshipping / Shopify) */
  function selectVariantOption(optionIndex, value, btnEl) {
    const parentGroup = btnEl.closest('.zv-variant-group');
    if (parentGroup) {
      parentGroup.querySelectorAll('.zv-size-pill').forEach(p => p.classList.remove('active'));
      btnEl.classList.add('active');
    }

    const labelSpan = document.getElementById('zv-val-' + optionIndex);
    if (labelSpan) labelSpan.textContent = value;

    const stickySize = document.getElementById('zv-sticky-size-val');
    const scarcitySize = document.getElementById('zv-stock-size-label');
    if (stickySize) stickySize.textContent = value;
    if (scarcitySize) scarcitySize.textContent = value;

    selectedOptionsState[optionIndex] = value;

    if (productVariants && productVariants.length > 0) {
      const matchedVariant = productVariants.find(v => {
        return v.options.every((optVal, idx) => optVal === selectedOptionsState[idx]);
      });

      if (matchedVariant) {
        const inputId = document.getElementById('zv-variant-id-input');
        if (inputId) inputId.value = matchedVariant.id;

        basePrice = matchedVariant.price / 100.0;
        const formattedPrice = currencySymbol + basePrice.toFixed(2);
        
        const displayPrice = document.getElementById('zv-display-price');
        if (displayPrice) displayPrice.textContent = formattedPrice;

        const stickyPrice = document.getElementById('zv-sticky-price-text');
        if (stickyPrice) stickyPrice.textContent = formattedPrice;

        if (matchedVariant.compare_at_price && matchedVariant.compare_at_price > matchedVariant.price) {
          const compFormatted = currencySymbol + (matchedVariant.compare_at_price / 100.0).toFixed(2);
          const displayComp = document.getElementById('zv-display-compare');
          if (displayComp) {
            displayComp.textContent = compFormatted;
            displayComp.style.display = 'inline';
          }
        }

        const qtyInput = document.getElementById('zv-cart-quantity');
        const qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;
        const btnPrice = document.getElementById('zv-btn-price');
        if (btnPrice) btnPrice.textContent = currencySymbol + (qty * basePrice).toFixed(2);

        const atcBtn = document.getElementById('zv-atc-button');
        if (atcBtn) {
          const atcLabel = atcBtn.querySelector('.zv-atc-label');
          if (!matchedVariant.available) {
            atcBtn.disabled = true;
            if (atcLabel) atcLabel.textContent = 'SOLD OUT';
            atcBtn.style.opacity = '0.6';
            atcBtn.style.cursor = 'not-allowed';
          } else {
            atcBtn.disabled = false;
            if (atcLabel) atcLabel.textContent = 'ADD TO CART';
            atcBtn.style.opacity = '1';
            atcBtn.style.cursor = 'pointer';
          }
        }

        if (matchedVariant.featured_image && matchedVariant.featured_image.src) {
          const matchedThumb = Array.from(galleryThumbEls).find(t => {
            return t.getAttribute('data-full-src')?.includes(matchedVariant.featured_image.src) || false;
          });
          if (matchedThumb) {
            matchedThumb.click();
          } else if (mainImg) {
            mainImg.src = matchedVariant.featured_image.src;
          }
        }
      }
    }
  }

  function selectFallbackSize(size, el) {
    const span = document.getElementById('zv-val-0');
    if (span) span.textContent = size;
    const stickySize = document.getElementById('zv-sticky-size-val');
    const scarcitySize = document.getElementById('zv-stock-size-label');
    if (stickySize) stickySize.textContent = size;
    if (scarcitySize) scarcitySize.textContent = size;
    const parent = el.closest('.zv-variant-group');
    if (parent) {
      parent.querySelectorAll('.zv-size-pill').forEach(p => p.classList.remove('active'));
      el.classList.add('active');
    }
  }

  function updateQuantity(change) {
    const input = document.getElementById('zv-cart-quantity');
    if (!input) return;
    let qty = parseInt(input.value) || 1;
    qty = Math.max(1, Math.min(10, qty + change));
    input.value = qty;

    const totalPrice = (qty * basePrice).toFixed(2);
    const formatted = currencySymbol + totalPrice;
    const btnPrice = document.getElementById('zv-btn-price');
    const stickyPrice = document.getElementById('zv-sticky-price-text');
    if (btnPrice) btnPrice.textContent = formatted;
    if (stickyPrice) stickyPrice.textContent = formatted;
  }

  function expressCheckout() {
    const variantId = document.getElementById('zv-variant-id-input').value;
    const qtyInput = document.getElementById('zv-cart-quantity');
    const qty = qtyInput ? qtyInput.value : 1;
    window.location.href = `/cart/${variantId}:${qty}`;
  }

  /* Live Viewers Fluctuation */
  function initLiveViewers() {
    const counter = document.getElementById('zv-live-viewers-count');
    if (!counter) return;

    let current = Math.floor(Math.random() * 14) + 26;
    counter.textContent = current;

    setInterval(() => {
      const change = Math.floor(Math.random() * 5) - 2;
      current = Math.max(22, Math.min(48, current + change));
      counter.textContent = current;
    }, 4000);
  }

  /* Delivery Timer */
  function initDeliveryCountdown() {
    const timerEl = document.getElementById('zv-cd-timer');
    if (!timerEl) return;

    function updateTimer() {
      const now = new Date();
      const target = new Date();
      target.setHours(17, 0, 0, 0);
      if (now > target) target.setDate(target.getDate() + 1);

      const diff = target - now;
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      const pad = n => n.toString().padStart(2, '0');
      timerEl.textContent = `${pad(hours)}h ${pad(minutes)}m ${pad(seconds)}s`;
    }

    updateTimer();
    setInterval(updateTimer, 1000);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeLightbox();
      closeSizeGuide();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    initLiveViewers();
    initDeliveryCountdown();
  });

  /* Sticky ATC Bar */
  window.addEventListener('scroll', function() {
    const buyBox = document.getElementById('zv-product-section');
    const stickyBar = document.getElementById('zv-sticky-bar');
    if (!buyBox || !stickyBar) return;
    const rect = buyBox.getBoundingClientRect();
    if (rect.bottom < 100) {
      stickyBar.classList.add('visible');
    } else {
      stickyBar.classList.remove('visible');
    }
  });
</script>

