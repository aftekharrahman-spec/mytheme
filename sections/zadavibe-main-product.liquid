<section class="zv-product-main" id="zv-product-section">
  <div class="zv-container">
    <!-- Breadcrumb Navigation -->
    <nav class="zv-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="zv-bc-sep">/</span>
      <a href="/collections/all">Menswear</a>
      <span class="zv-bc-sep">/</span>
      <span class="zv-bc-current">{{ product.title | default: "Signature Vintage Henley" }}</span>
    </nav>

    <div class="zv-product-grid">
      <!-- Media Gallery -->
      <div class="zv-gallery-sticky">
        <div class="zv-gallery-modern-wrap">
          <!-- Left Vertical Thumbnails (Desktop) / Horizontal (Mobile) -->
          <div class="zv-thumbs-track" id="zv-thumbs-track">
            {%- if product.images.size > 0 -%}
              {%- for image in product.images -%}
                <div
                  class="zv-thumb-btn{% if forloop.first %} active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  data-full-src="{{ image | image_url: width: 1400 }}"
                  onclick="selectGalleryImage({{ forloop.index0 }}, '{{ image | image_url: width: 1200 }}', this)"
                >
                  <img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">
                </div>
              {%- endfor -%}
            {%- else -%}
              <div
                class="zv-thumb-btn active"
                data-index="0"
                data-full-src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}"
                onclick="selectGalleryImage(0, '{{ 'zadavibe-product-shirt.jpg' | asset_url }}', this)"
              >
                <img src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}" alt="Shirt Front">
              </div>
              <div
                class="zv-thumb-btn"
                data-index="1"
                data-full-src="{{ 'zadavibe-model-hero.jpg' | asset_url }}"
                onclick="selectGalleryImage(1, '{{ 'zadavibe-model-hero.jpg' | asset_url }}', this)"
              >
                <img src="{{ 'zadavibe-model-hero.jpg' | asset_url }}" alt="Model Fit">
              </div>
            {%- endif -%}
          </div>

          <!-- Main Stage Hero Image with Hover Magnifier -->
          <div class="zv-main-stage-box" id="zv-stage-box">
            <!-- Floating Badges -->
            <div class="zv-stage-badges">
              <span class="zv-badge-best">🔥 BESTSELLER</span>
              <span class="zv-badge-discount">40% OFF</span>
            </div>

            <!-- Lightbox Zoom Icon -->
            <button type="button" class="zv-zoom-trigger-btn" onclick="openLightbox()" aria-label="Open Fullscreen Image View">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Zoom">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>

            <!-- Nav Arrows -->
            <button type="button" class="zv-stage-arrow zv-stage-prev" onclick="prevGalleryImage()" aria-label="Previous Image">‹</button>
            <button type="button" class="zv-stage-arrow zv-stage-next" onclick="nextGalleryImage()" aria-label="Next Image">›</button>

            <!-- Main Image Element with Pan Zoom -->
            <div class="zv-stage-inner" id="zv-stage-inner">
              {%- if product.featured_image -%}
                <img id="zv-main-img" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}">
              {%- else -%}
                <img id="zv-main-img" src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}" alt="Zadavibe Product" onerror="this.src='{{ 'zadavibe-model-hero.jpg' | asset_url }}'">
              {%- endif -%}
            </div>

            <!-- Mobile Dots & Counter -->
            <div class="zv-mobile-counter-chip">
              <span id="zv-img-current-index">1</span> / <span id="zv-img-total-count">{% if product.images.size > 0 %}{{ product.images.size }}{% else %}2{% endif %}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Buy Box Info -->
      <div class="zv-product-info">
        <!-- Rating and Verification -->
        <div class="zv-rating-row">
          <div class="zv-stars">★★★★★</div>
          <span class="zv-rating-score">4.9 / 5.0</span>
          <span class="zv-verified-badge">✓ Verified UAE Menswear</span>
        </div>

        <!-- Live Viewers Pulse Badge -->
        <div class="zv-live-viewers-badge">
          <span class="zv-live-pulse-dot"></span>
          <span class="zv-live-viewers-text">
            <strong id="zv-live-viewers-count">34</strong> men are viewing this right now
          </span>
        </div>

        <h1 class="zv-product-title">
          {{ product.title | default: "Zadavibe Signature Vintage Lace-Up Ribbed Henley" }}
        </h1>

        <!-- Price Section -->
        <div class="zv-price-card">
          <div class="zv-price-flex">
            <span class="zv-price-current" id="zv-display-price">
              {%- if product.selected_or_first_available_variant.price -%}
                {{ product.selected_or_first_available_variant.price | money }}
              {%- elsif product.price -%}
                {{ product.price | money }}
              {%- else -%}
                AED 149.00
              {%- endif -%}
            </span>
            <span class="zv-price-compare" id="zv-display-compare">
              {%- if product.selected_or_first_available_variant.compare_at_price -%}
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              {%- elsif product.compare_at_price -%}
                {{ product.compare_at_price | money }}
              {%- else -%}
                AED 249.00
              {%- endif -%}
            </span>
            <span class="zv-sale-pill">SAVE 40% OFF</span>
          </div>
          <div class="zv-tax-note">UAE VAT Included • Free Shipping on orders over AED 150</div>
        </div>

        <!-- UAE Next-Day Delivery Countdown Box -->
        <div class="zv-countdown-box">
          <div class="zv-cd-icon">⚡</div>
          <div class="zv-cd-content">
            <div class="zv-cd-title">Order in the next <span id="zv-cd-timer" class="zv-cd-timer">03h 42m 18s</span></div>
            <div class="zv-cd-subtitle">To receive by <strong id="zv-delivery-day">Tuesday</strong> with <strong>UAE Express Next-Day Dispatch</strong>!</div>
          </div>
        </div>

        <!-- Low Stock Scarcity Bar -->
        <div class="zv-scarcity-card">
          <div class="zv-scarcity-header">
            <span>🔥 <strong>High Demand:</strong> Only <strong id="zv-stock-number">6</strong> left in stock for size <span id="zv-stock-size-label">M</span>!</span>
          </div>
          <div class="zv-scarcity-bar">
            <div class="zv-scarcity-fill" style="width: 32%;"></div>
          </div>
        </div>

        <!-- Dynamic Product Options (Sizes, Colors from CJ Dropshipping / Shopify) -->
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="zv-variant-group" data-option-index="{{ forloop.index0 }}">
              <div class="zv-variant-header-row">
                <label class="zv-variant-label">
                  SELECT {{ option.name | upcase }}: <span class="zv-selected-val" id="zv-val-{{ forloop.index0 }}" style="color: var(--zv-primary);">{{ option.selected_value }}</span>
                </label>
                {%- if option.name contains 'Size' or option.name contains 'size' or option.name contains 'SIZE' -%}
                  <button type="button" class="zv-size-guide-link" onclick="openSizeGuide()">
                    📏 Size Guide & Fit
                  </button>
                {%- endif -%}
              </div>

              <div class="zv-size-pills">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="zv-size-pill{% if option.selected_value == value %} active{% endif %}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-value="{{ value | escape }}"
                    onclick="selectVariantOption({{ forloop.parentloop.index0 }}, '{{ value | escape }}', this)"
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback demo sizes for preview mode -->
          <div class="zv-variant-group">
            <div class="zv-variant-header-row">
              <label class="zv-variant-label">SELECT SIZE: <span class="zv-selected-val" id="zv-val-0" style="color: var(--zv-primary);">M</span></label>
              <button type="button" class="zv-size-guide-link" onclick="openSizeGuide()">
                📏 Size Guide & Fit
              </button>
            </div>
            <div class="zv-size-pills">
              <button type="button" class="zv-size-pill" onclick="selectFallbackSize('S', this)">S</button>
              <button type="button" class="zv-size-pill active" onclick="selectFallbackSize('M', this)">M</button>
              <button type="button" class="zv-size-pill" onclick="selectFallbackSize('L', this)">L</button>
              <button type="button" class="zv-size-pill" onclick="selectFallbackSize('XL', this)">XL</button>
              <button type="button" class="zv-size-pill" onclick="selectFallbackSize('XXL', this)">XXL</button>
            </div>
          </div>
        {%- endunless -%}

        <!-- Actions Form -->
        <form method="post" action="/cart/add" id="zv-add-form">
          <input type="hidden" name="id" id="zv-variant-id-input" value="{{ product.selected_or_first_available_variant.id | default: 1 }}">

          <!-- Modern Quantity Stepper -->
          <div class="zv-quantity-group">
            <label class="zv-variant-label" for="zv-cart-quantity">QUANTITY:</label>
            <div class="zv-qty-stepper">
              <button type="button" class="zv-qty-btn" onclick="updateQuantity(-1)" aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" id="zv-cart-quantity" value="1" min="1" max="10" readonly>
              <button type="button" class="zv-qty-btn" onclick="updateQuantity(1)" aria-label="Increase quantity">+</button>
            </div>
          </div>
          
          <div class="zv-buy-actions">
            <!-- Primary Add To Cart Button with Shimmer -->
            <button type="submit" class="zv-btn-primary zv-btn-atc" id="zv-atc-button"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
              <span class="zv-atc-text">{% if product.selected_or_first_available_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</span>
              <span class="zv-atc-divider">•</span>
              <span id="zv-btn-price" class="zv-atc-price">
                {%- if product.selected_or_first_available_variant.price -%}
                  {{ product.selected_or_first_available_variant.price | money }}
                {%- elsif product.price -%}
                  {{ product.price | money }}
                {%- else -%}
                  AED 149.00
                {%- endif -%}
              </span>
            </button>

            <!-- Express Cash On Delivery / Direct Buy -->
            <button type="button" class="zv-btn-buynow" onclick="expressCheckout()">
              <span>⚡ ORDER WITH CASH ON DELIVERY (COD)</span>
            </button>
          </div>
        </form>

        <!-- UAE Reassurance Card -->
        <div class="zv-reassurance-card">
          <div class="zv-reassurance-row">
            <div class="zv-reassurance-item">
              <span class="zv-reassurance-icon">🚚</span>
              <div>
                <strong>Free Express UAE Shipping</strong>
                <p>Delivery across Dubai, Abu Dhabi & all Emirates</p>
              </div>
            </div>
            <div class="zv-reassurance-item">
              <span class="zv-reassurance-icon">💵</span>
              <div>
                <strong>Cash on Delivery (COD) Available</strong>
                <p>Pay cash when your parcel arrives</p>
              </div>
            </div>
            <div class="zv-reassurance-item">
              <span class="zv-reassurance-icon">🔄</span>
              <div>
                <strong>14-Day Free Exchange & Return</strong>
                <p>Doorstep size swap hassle-free</p>
              </div>
            </div>
            <div class="zv-reassurance-item">
              <span class="zv-reassurance-icon">🛡️</span>
              <div>
                <strong>100% Certified Organic Ribbed Cotton</strong>
                <p>Guaranteed authentic tailoring & fit</p>
              </div>
            </div>
          </div>

          <!-- Official Payment SVGs -->
          <div class="zv-payment-icons-strip">
            <span class="zv-pay-secure-label">GUARANTEED SAFE CHECKOUT:</span>
            <div class="zv-pay-svgs">
              <!-- Visa -->
              <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Visa"><rect width="38" height="24" rx="4" fill="#1434CB"/><path d="M15.4 16.5h-2.3l1.4-9h2.3l-1.4 9zm9.2-8.8c-.5-.2-1.2-.4-2.1-.4-2.3 0-4 1.2-4 3 0 1.3 1.2 2 2.1 2.4.9.5 1.2.8 1.2 1.2 0 .6-.8.9-1.5.9-.9 0-1.5-.2-2.3-.5l-.3-.2-.3 2c.6.3 1.6.5 2.7.5 2.5 0 4.1-1.2 4.1-3.1 0-1-.6-1.8-2-2.4-.8-.4-1.3-.7-1.3-1.2 0-.4.5-.8 1.4-.8.8 0 1.4.2 1.8.4l.2.1.4-1.8zm6.5 4.3l1-2.8.6 2.8h-1.6zm2.4 4.5h2.1l-1.8-9h-2c-.6 0-1.1.2-1.3.8l-3.8 8.2h2.4l.5-1.4h3l.1 1.4zm-12.7-9l-1.8 6.1-.2-1-.7-3.6c-.1-.7-.6-1.5-1.3-1.5H12l-.2.8c.8.2 1.7.5 2.3.8.3.2.5.6.6 1.1l1.8 6.7h2.4l3.6-9.4h-2.1z" fill="#FFF"/></svg>
              <!-- Mastercard -->
              <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Mastercard"><rect width="38" height="24" rx="4" fill="#0A0A0A"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8a7 7 0 010 10.4 7 7 0 010-10.4z" fill="#FF5F00"/></svg>
              <!-- Amex -->
              <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="American Express"><rect width="38" height="24" rx="4" fill="#0077A6"/><path d="M7 16h3.4l.7-1.7h3.6l.7 1.7H19l-3.5-8h-3.9L7 16zm5.8-3.4l1.1-2.7 1.1 2.7h-2.2zM20.2 8v8h5.8v-1.7h-3.8v-1.5h3.6v-1.7h-3.6V9.7H26V8h-5.8zm7.3 0l1.9 4-1.9 4h2.2l.9-1.9.9 1.9h2.2l-1.9-4 1.9-4h-2.2l-.9 1.9-.9-1.9h-2.2z" fill="#FFF"/></svg>
              <!-- Apple Pay -->
              <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Apple Pay"><rect width="38" height="24" rx="4" fill="#000"/><path d="M15.2 10.8c-.3.4-.8.7-1.3.6-.1-.5.1-1 .4-1.3.3-.4.8-.6 1.3-.6.1.5-.1 1-.4 1.3zm.4 1.4c-.7 0-1.3.4-1.6.4-.3 0-.8-.4-1.4-.4-.7 0-1.4.4-1.8 1.1-.7 1.3-.2 3.2.5 4.3.4.5.8 1.1 1.4 1.1.5 0 .8-.4 1.4-.4.6 0 .8.4 1.4.4.6 0 1-.5 1.4-1.1.4-.6.6-1.2.6-1.2s-.7-.3-.7-1.2c0-.8.6-1.2.6-1.2-.4-.6-1-.7-1.2-.7zm4.2-2.7h1.4v7.3h-1.4V9.5zm4.8 2.2c1.1 0 1.9.8 1.9 2s-.8 2-1.9 2c-.6 0-1.1-.2-1.4-.6v2.3h-1.3V11.8h1.2v.5c.3-.4.8-.6 1.5-.6zm-.3 3c.6 0 1-.4 1-1s-.4-1-1-1-.9.4-.9 1 .3 1 .9 1zm6.7-.8c0 1.2-.9 2-2.2 2-1.2 0-2.1-.8-2.1-2s.9-2 2.1-2c1.3 0 2.2.8 2.2 2zm-1.3 0c0-.6-.4-1-1-1s-.9.4-.9 1 .4 1 .9 1c.5 0 1-.4 1-1z" fill="#FFF"/></svg>
              <!-- Google Pay -->
              <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Google Pay"><rect width="38" height="24" rx="4" fill="#FFF" stroke="#E5E7EB"/><path d="M15.4 12.1v3.4h-1.2V7.7h3.1c.8 0 1.5.3 2 .8.5.5.8 1.2.8 2s-.3 1.5-.8 2c-.5.5-1.2.8-2 .8h-1.9zm0-3.3v2.3h1.9c.5 0 .9-.2 1.2-.5.3-.3.5-.7.5-1.2 0-.4-.2-.8-.5-1.1-.3-.3-.7-.5-1.2-.5h-1.9zm8.5 2.1c.8 0 1.4.2 1.9.6.5.4.7 1 .7 1.7v3h-1.1v-.7c-.3.5-.8.9-1.5.9-.6 0-1.1-.2-1.5-.5-.4-.3-.6-.8-.6-1.3 0-.6.2-1 .6-1.3.4-.3 1-.5 1.7-.5.6 0 1.1.1 1.5.3v-.2c0-.4-.1-.7-.4-.9-.3-.2-.7-.4-1.1-.4-.6 0-1.1.3-1.4.8l-1.1-.7c.5-.8 1.4-1.1 2.3-1.1zm-1.8 3.5c0 .3.1.5.3.7.2.2.5.3.8.3.4 0 .8-.2 1.1-.5.3-.3.5-.7.5-1.1-.3-.2-.8-.3-1.3-.3-.4 0-.8.1-1 .3-.3.1-.4.4-.4.6zm6.3-1.9l1.4 3.4 1.4-3.4h1.3l-2.1 4.8-1.2 2.7h-1.2l.9-1.9-2-5.6h1.5z" fill="#3C4043"/><path d="M10.8 12.1c0-.2 0-.4-.1-.6H7v1.4h2.1c-.1.5-.4 1-.8 1.3v1.1h1.3c.8-.7 1.2-1.9 1.2-3.2z" fill="#4285F4"/><path d="M7 16c1.1 0 2-.4 2.7-1.1l-1.3-1.1c-.4.3-.9.4-1.4.4-.8 0-1.5-.5-1.8-1.3H3.8v1.1C4.5 15.3 5.7 16 7 16z" fill="#34A853"/><path d="M5.2 13c-.1-.3-.1-.6-.1-.9 0-.3 0-.6.1-.9V10H3.8C3.3 11 3.3 12.2 3.8 13.2l1.4-.2z" fill="#FBBC04"/><path d="M7 8.7c.6 0 1.2.2 1.6.6l1.2-1.2C9 7.3 8 6.9 7 6.9c-1.3 0-2.5.7-3.2 1.9l1.4 1.1c.3-.7 1-1.2 1.8-1.2z" fill="#EA4335"/></svg>
            </div>
          </div>
        </div>

        <!-- Luxury Product Accordion Tabs -->
        <div class="zv-accordions-group">
          <!-- Tab 1: Product Details -->
          <div class="zv-accordion-item">
            <button type="button" class="zv-acc-trigger active" onclick="toggleAccordion(this)">
              <span class="zv-acc-title">👔 Details & Athletic Silhouette</span>
              <span class="zv-acc-arrow">−</span>
            </button>
            <div class="zv-acc-content open">
              <div class="zv-acc-inner">
                {%- if product.description != blank -%}
                  <div class="zv-rich-desc">{{ product.description }}</div>
                {%- else -%}
                  <p>Engineered for the modern gentleman, this signature ribbed henley fuses rugged vintage bohemia with tailored athletic engineering. Features a structured chest cut and tapered waist that naturally flatters athletic builds.</p>
                {%- endif -%}
                <ul class="zv-acc-bullets">
                  <li><strong>Collar:</strong> Hand-braided micro-rope lace-up placket with metal grommets</li>
                  <li><strong>Knit:</strong> 260 GSM heavyweight micro-ribbed breathable weave</li>
                  <li><strong>Sleeves:</strong> Comfort rib cuffs that stay securely on the forearm when pushed up</li>
                  <li><strong>Colorfast:</strong> Deep yarn-dyed tones that will never fade in hot climates</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Tab 2: Fabric & Care -->
          <div class="zv-accordion-item">
            <button type="button" class="zv-acc-trigger" onclick="toggleAccordion(this)">
              <span class="zv-acc-title">🧵 Fabric Engineering & Washing Guide</span>
              <span class="zv-acc-arrow">+</span>
            </button>
            <div class="zv-acc-content">
              <div class="zv-acc-inner">
                <p>Crafted from 100% sustainably harvested organic cotton micro-ribbed knit. Pre-shrunk via enzyme bio-washing to ensure zero shrinkage after laundering.</p>
                <ul class="zv-acc-bullets">
                  <li>✓ Machine wash cold (30°C) with similar earth tones</li>
                  <li>✓ Do not bleach; use mild eco-friendly detergent</li>
                  <li>✓ Tumble dry low or hang dry in the shade to preserve cotton elasticity</li>
                  <li>✓ Warm iron inside-out if required</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Tab 3: UAE Shipping & Exchanges -->
          <div class="zv-accordion-item">
            <button type="button" class="zv-acc-trigger" onclick="toggleAccordion(this)">
              <span class="zv-acc-title">✈️ UAE Express Delivery & 14-Day Exchanges</span>
              <span class="zv-acc-arrow">+</span>
            </button>
            <div class="zv-acc-content">
              <div class="zv-acc-inner">
                <ul class="zv-acc-bullets">
                  <li><strong>Dubai, Sharjah, Ajman:</strong> Next-day express delivery for orders placed before 5:00 PM.</li>
                  <li><strong>Abu Dhabi, RAK, Fujairah, UAQ:</strong> 1 to 2 business days via courier.</li>
                  <li><strong>Cash on Delivery (COD):</strong> Fully supported across all UAE Emirates.</li>
                  <li><strong>Hassle-Free Size Swaps:</strong> Not the right fit? Contact us via WhatsApp for a quick courier doorstep swap.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Size Guide Modal -->
<div class="zv-modal-overlay" id="zv-size-modal" onclick="closeSizeGuide(event)">
  <div class="zv-modal-card" onclick="event.stopPropagation()">
    <div class="zv-modal-header">
      <h3 class="zv-modal-title">📏 MEN'S SIZE & FIT GUIDE</h3>
      <button type="button" class="zv-modal-close" onclick="closeSizeGuide()" aria-label="Close modal">✕</button>
    </div>
    <div class="zv-modal-body">
      <p class="zv-size-advice">
        <strong>Fit Recommendation:</strong> Our signature henley is designed with a tapered athletic fit. If you prefer a loose, relaxed bohemian drape, we recommend sizing up one size.
      </p>
      <div class="zv-table-responsive">
        <table class="zv-size-table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest (CM)</th>
              <th>Chest (Inches)</th>
              <th>Length (CM)</th>
              <th>Shoulder (CM)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
