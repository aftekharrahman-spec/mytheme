{%- liquid
  if collection.description != blank
    assign banner_desc = collection.description
  else
    assign col_title_lower = collection.title | downcase
    assign col_handle_lower = collection.handle | downcase
    if col_title_lower contains 'shoe' or col_handle_lower contains 'shoe' or col_title_lower contains 'footwear'
      assign banner_desc = "Discover ZadaVibe luxury men's footwear, handcrafted leather loafers, sneakers, and slip-ons engineered with premium materials for Dubai and UAE gentlemen."
    elsif col_title_lower contains 'shirt' or col_handle_lower contains 'shirt' or col_title_lower contains 'henley'
      assign banner_desc = "Explore our signature vintage lace-up henleys and ribbed knits engineered with 100% organic breathable cotton and athletic tailored drape."
    else
      assign banner_desc = "Explore the ZadaVibe " | append: collection.title | append: " collection. Handcrafted luxury designs engineered with superior materials and fast doorstep express delivery across the UAE."
    endif
  endif
-%}

<div class="zv-collection-banner">
  <div class="zv-container">
    <div class="zv-collection-banner-content">
      <span class="zv-hero-pill-badge" style="margin-bottom: 12px;">
        <span>✨</span> {{ section.settings.badge | default: 'ZadaVibe Curated Collection' }}
      </span>
      <h1 class="zv-section-title" style="font-size: clamp(2rem, 3.8vw, 3.2rem); margin-bottom: 14px;">
        {{ collection.title | default: "Men's Luxury Menswear" }}
      </h1>
      <p class="zv-section-subtitle" style="max-width: 680px; margin: 0 auto 26px;">
        {{ banner_desc }}
      </p>

      <!-- Quick Category Filter Pills -->
      <div class="zv-collection-pills">
        <a href="/collections/all" class="zv-cat-pill{% if collection.handle == 'all' or collection.handle == blank %} active{% endif %}">
          🔥 All Products
        </a>
        <a href="/collections/shoes" class="zv-cat-pill{% if collection.handle == 'shoes' %} active{% endif %}">
          👟 Shoes & Footwear
        </a>
        {%- for col in collections limit: 8 -%}
          {%- unless col.handle == 'all' or col.handle == 'frontpage' or col.handle == 'shoes' -%}
            <a href="{{ col.url }}" class="zv-cat-pill{% if collection.handle == col.handle %} active{% endif %}">
              {{ col.title }}
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  .zv-collection-banner {
    background: linear-gradient(180deg, #fdfbf7 0%, #f4efe6 100%);
    padding: 60px 0 50px;
    text-align: center;
    border-bottom: 1px solid var(--zv-border);
  }

  .zv-collection-pills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  .zv-cat-pill {
    background: #ffffff;
    border: 1.5px solid var(--zv-border);
    border-radius: var(--zv-radius-pill);
    padding: 8px 20px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--zv-text);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .zv-cat-pill:hover,
  .zv-cat-pill.active {
    background: var(--zv-primary);
    color: #ffffff;
    border-color: var(--zv-primary);
  }

  @media (max-width: 768px) {
    .zv-collection-banner {
      padding: 36px 0 28px;
    }

    .zv-collection-pills {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding: 4px 16px 8px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .zv-collection-pills::-webkit-scrollbar {
      display: none;
    }

    .zv-cat-pill {
      flex-shrink: 0;
      padding: 6px 14px;
      font-size: 0.82rem;
    }
  }
</style>

{% schema %}
{
  "name": "ZV Collection Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Top Badge",
      "default": "Signature Menswear Collection"
    }
  ],
  "presets": [
    {
      "name": "ZV Collection Banner"
    }
  ]
}
{% endschema %}
