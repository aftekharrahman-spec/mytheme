<section class="zv-featured-products-section">
  <div class="zv-container">
    <div class="zv-fp-header-wrap">
      <div class="zv-fp-tag-pill">
        <span class="zv-pulse-dot"></span>
        <span>{{ section.settings.eyebrow | default: "CURATED ESSENTIALS • AUTUMN / SPRING DROP" }}</span>
      </div>
      <h2 class="zv-fp-title">{{ section.settings.heading | default: "Trending Menswear Drops" }}</h2>
      <p class="zv-fp-subtitle">{{ section.settings.subheading | default: "Engineered with breathable organic micro-ribbed knit, athletic tailoring, and vintage bohemian cords." }}</p>
    </div>

    <!-- Interactive Category Filter Chips -->
    <div class="zv-fp-filter-bar">
      <button type="button" class="zv-fp-filter-chip active" onclick="filterHomeProducts('all', this)">🔥 All Drops</button>
      <button type="button" class="zv-fp-filter-chip" onclick="filterHomeProducts('henley', this)">👔 Vintage Henleys</button>
      <button type="button" class="zv-fp-filter-chip" onclick="filterHomeProducts('knit', this)">🧶 Ribbed Knits</button>
      <button type="button" class="zv-fp-filter-chip" onclick="filterHomeProducts('earth', this)">🌿 Earth Tones</button>
    </div>

    <!-- Products Grid -->
    <div class="zv-fp-grid" id="zv-home-products-grid">
      {%- assign feat_collection = section.settings.collection -%}
      {%- if feat_collection != blank and feat_collection.products.size > 0 -%}
        {%- for prod in feat_collection.products limit: section.settings.products_to_show -%}
          <div class="zv-fp-card" data-category="{% cycle 'henley', 'knit', 'earth', 'henley' %}">
            <div class="zv-fp-media">
              {%- if prod.compare_at_price > prod.price -%}
                <span class="zv-fp-badge-sale">SAVE 40%</span>
              {%- elsif forloop.first -%}
                <span class="zv-fp-badge-hot">BESTSELLER</span>
              {%- endif -%}

              <a href="{{ prod.url }}" class="zv-fp-img-link">
                {%- if prod.featured_image -%}
                  <img
                    src="{{ prod.featured_image | image_url: width: 600 }}"
                    alt="{{ prod.title | escape }} - Men's Fashion Dubai UAE | ZadaVibe"
                    width="500"
                    height="650"
                    loading="lazy"
                    class="zv-fp-main-img"
                  >
                {%- else -%}
                  <img
                    src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}"
                    alt="{{ prod.title | escape }} - Men's Fashion Dubai UAE | ZadaVibe"
                    width="500"
                    height="650"
                    loading="lazy"
                    class="zv-fp-main-img"
                  >
                {%- endif -%}
              </a>

              <div class="zv-fp-overlay-actions">
                <a href="{{ prod.url }}" class="zv-fp-quick-btn">
                  <span>SELECT SIZE & BUY</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>

            <div class="zv-fp-info">
              <div class="zv-fp-rating">
                <span class="zv-fp-stars">★★★★★</span>
                <span class="zv-fp-review-cnt">(4.9)</span>
              </div>
              <h3 class="zv-fp-prod-title">
                <a href="{{ prod.url }}">{{ prod.title }}</a>
              </h3>
              <div class="zv-fp-price-row">
                <span class="zv-fp-price-curr">AED {{ prod.price | money_without_currency }}</span>
                {%- if prod.compare_at_price > prod.price -%}
                  <span class="zv-fp-price-was">AED {{ prod.compare_at_price | money_without_currency }}</span>
                {%- endif -%}
              </div>

              <!-- Color dots preview -->
              <div class="zv-fp-swatches">
                <span class="zv-swatch-dot zv-swatch-olive" title="Olive Green"></span>
                <span class="zv-swatch-dot zv-swatch-sand" title="Sand Beige"></span>
                <span class="zv-swatch-dot zv-swatch-black" title="Charcoal Black"></span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Curated Demo Menswear Items (Instant Luxury Experience) -->
        {%- assign fallback_titles = "Vintage Lace-Up Ribbed Henley,Boho Corded Knit Henley,Textured Waffle Athletic Pullover,Minimalist Heavyweight Camp Shirt" | split: "," -%}
        {%- assign fallback_prices = "149.00,159.00,179.00,139.00" | split: "," -%}
        {%- assign fallback_compares = "249.00,269.00,289.00,229.00" | split: "," -%}
        {%- assign fallback_tags = "BESTSELLER,HOT DROP,LIMITED,NEW" | split: "," -%}
        {%- assign fallback_cats = "henley,knit,earth,henley" | split: "," -%}

        {%- for title in fallback_titles -%}
          {%- assign idx = forloop.index0 -%}
          <div class="zv-fp-card" data-category="{{ fallback_cats[idx] }}">
            <div class="zv-fp-media">
              <span class="zv-fp-badge-hot">{{ fallback_tags[idx] }}</span>

              <a href="/collections/all" class="zv-fp-img-link">
                {%- if forloop.index == 2 or forloop.index == 4 -%}
                  <img
                    src="{{ 'zadavibe-model-hero.jpg' | asset_url }}"
                    alt="{{ title }} - Luxury Ribbed Menswear Dubai UAE"
                    width="500"
                    height="650"
                    loading="lazy"
                    class="zv-fp-main-img"
                  >
                {%- else -%}
                  <img
                    src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}"
                    alt="{{ title }} - Vintage Lace-Up Henley Dubai UAE"
                    width="500"
                    height="650"
                    loading="lazy"
                    class="zv-fp-main-img"
                  >
                {%- endif -%}
              </a>

              <div class="zv-fp-overlay-actions">
                <a href="/collections/all" class="zv-fp-quick-btn">
                  <span>SELECT SIZE & BUY</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>

            <div class="zv-fp-info">
              <div class="zv-fp-rating">
                <span class="zv-fp-stars">★★★★★</span>
                <span class="zv-fp-review-cnt">(4.9)</span>
              </div>
              <h3 class="zv-fp-prod-title">
                <a href="/collections/all">{{ title }}</a>
              </h3>
              <div class="zv-fp-price-row">
                <span class="zv-fp-price-curr">AED {{ fallback_prices[idx] }}</span>
                <span class="zv-fp-price-was">AED {{ fallback_compares[idx] }}</span>
              </div>

              <!-- Color dots preview -->
              <div class="zv-fp-swatches">
                <span class="zv-swatch-dot zv-swatch-olive" title="Olive Green"></span>
                <span class="zv-swatch-dot zv-swatch-sand" title="Sand Khaki"></span>
                <span class="zv-swatch-dot zv-swatch-black" title="Coal Black"></span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Big Vibrant "All Products" Button -->
    <div class="zv-fp-cta-wrap">
      <a href="{{ section.settings.all_products_url | default: '/collections/all' }}" class="zv-fp-all-btn">
        <span>{{ section.settings.button_label | default: "EXPLORE ALL PRODUCTS" }}</span>
        <span class="zv-fp-btn-arrow">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
      <div class="zv-fp-cta-subtext">
        <span>⚡ Same-Day UAE Dispatch</span> • <span>📦 Free Shipping Over AED 150</span> • <span>🔄 30-Day Easy Exchange</span>
      </div>
    </div>
  </div>
</section>

<style>
  .zv-featured-products-section {
    padding: 70px 0 85px;
    background: linear-gradient(180deg, #fdfbf7 0%, #f7f3eb 100%);
    position: relative;
    overflow: hidden;
  }

  .zv-fp-header-wrap {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 32px;
  }

  .zv-fp-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #e2ddd3;
    padding: 6px 18px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--zv-accent, #c07a50);
    letter-spacing: 0.1em;
    margin-bottom: 14px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.04);
  }

  .zv-pulse-dot {
    width: 8px;
    height: 8px;
    background: #16a34a;
    border-radius: 50%;
    animation: zvPulseGlow 2s infinite ease-in-out;
  }

  @keyframes zvPulseGlow {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .zv-fp-title {
    font-family: var(--zv-font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--zv-primary, #2d3b31);
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .zv-fp-subtitle {
    font-family: var(--zv-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 1rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  /* Filter Bar */
  .zv-fp-filter-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .zv-fp-filter-chip {
    background: #ffffff;
    border: 1.5px solid #ded9ce;
    border-radius: 999px;
    padding: 8px 20px;
    font-size: 0.92rem;
    font-weight: 700;
    color: #444c45;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }

  .zv-fp-filter-chip:hover {
    border-color: #2d3b31;
    color: #2d3b31;
    transform: translateY(-1px);
  }

  .zv-fp-filter-chip.active {
    background: #2d3b31;
    color: #ffffff;
    border-color: #2d3b31;
    box-shadow: 0 4px 16px rgba(45, 59, 49, 0.25);
  }

  /* Products Grid */
  .zv-fp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .zv-fp-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e8e3d8;
    box-shadow: 0 6px 20px rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .zv-fp-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 34px rgba(45, 59, 49, 0.12);
    border-color: #c07a50;
  }

  .zv-fp-media {
    position: relative;
    aspect-ratio: 1 / 1.05;
    background: #f2eee6;
    overflow: hidden;
  }

  .zv-fp-img-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .zv-fp-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .zv-fp-card:hover .zv-fp-main-img {
    transform: scale(1.06);
  }

  .zv-fp-badge-hot {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #c07a50;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    z-index: 2;
    box-shadow: 0 3px 8px rgba(192, 122, 80, 0.35);
  }

  .zv-fp-badge-sale {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #dc2626;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    z-index: 2;
    box-shadow: 0 3px 8px rgba(220, 38, 38, 0.35);
  }

  .zv-fp-overlay-actions {
    position: absolute;
    inset-inline: 12px;
    bottom: 12px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.25s ease;
    z-index: 3;
  }

  .zv-fp-card:hover .zv-fp-overlay-actions {
    opacity: 1;
    transform: translateY(0);
  }

  .zv-fp-quick-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 11px;
    background: rgba(20, 26, 21, 0.94);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .zv-fp-quick-btn:hover {
    background: #c07a50;
  }

  .zv-fp-info {
    padding: 16px 18px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .zv-fp-rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .zv-fp-stars {
    color: #f59e0b;
    font-size: 0.92rem;
    letter-spacing: 1px;
  }

  .zv-fp-review-cnt {
    font-size: 0.8rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .zv-fp-prod-title {
    font-family: var(--zv-font-heading, 'Outfit', sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 10px;
  }

  .zv-fp-prod-title a {
    color: var(--zv-primary, #2d3b31);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .zv-fp-prod-title a:hover {
    color: var(--zv-accent, #c07a50);
  }

  .zv-fp-price-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .zv-fp-price-curr {
    font-family: var(--zv-font-heading, 'Outfit', sans-serif);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--zv-primary, #2d3b31);
  }

  .zv-fp-price-was {
    font-size: 0.95rem;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .zv-fp-swatches {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }

  .zv-swatch-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid #ffffff;
    box-shadow: 0 0 0 1px #d1d5db;
    cursor: pointer;
  }

  .zv-swatch-olive { background: #4a5d4e; }
  .zv-swatch-sand { background: #d7c4aa; }
  .zv-swatch-black { background: #1c211d; }

  /* Big Vibrant CTA Button */
  .zv-fp-cta-wrap {
    text-align: center;
    margin-top: 50px;
  }

  .zv-fp-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 18px 46px;
    background: linear-gradient(135deg, #2d3b31 0%, #17211a 100%);
    color: #ffffff;
    border-radius: 999px;
    font-family: var(--zv-font-heading, 'Outfit', sans-serif);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    border: 2px solid rgba(192, 122, 80, 0.4);
    box-shadow: 0 10px 30px rgba(45, 59, 49, 0.3);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .zv-fp-all-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #c07a50 0%, #a45a30 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .zv-fp-all-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 16px 40px rgba(192, 122, 80, 0.4);
    border-color: #c07a50;
  }

  .zv-fp-all-btn:hover::before {
    opacity: 1;
  }

  .zv-fp-all-btn span {
    position: relative;
    z-index: 2;
  }

  .zv-fp-btn-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    transition: transform 0.25s ease;
  }

  .zv-fp-all-btn:hover .zv-fp-btn-arrow {
    transform: translateX(4px);
    background: #ffffff;
    color: #2d3b31;
  }

  .zv-fp-cta-subtext {
    margin-top: 14px;
    font-size: 0.88rem;
    color: #6b726c;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Mobile Responsiveness */
  @media (max-width: 992px) {
    .zv-fp-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 600px) {
    .zv-featured-products-section {
      padding: 44px 0 60px;
    }

    .zv-fp-header-wrap {
      margin-bottom: 24px;
    }

    .zv-fp-tag-pill {
      font-size: 0.78rem;
      padding: 5px 14px;
    }

    .zv-fp-title {
      font-size: 1.6rem;
    }

    .zv-fp-subtitle {
      font-size: 0.92rem;
    }

    .zv-fp-filter-bar {
      gap: 6px;
      margin-bottom: 24px;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 6px;
      scrollbar-width: none;
    }

    .zv-fp-filter-bar::-webkit-scrollbar {
      display: none;
    }

    .zv-fp-filter-chip {
      padding: 6px 14px;
      font-size: 0.84rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .zv-fp-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .zv-fp-card {
      border-radius: 12px;
    }

    .zv-fp-info {
      padding: 12px 10px 14px;
    }

    .zv-fp-prod-title {
      font-size: 0.92rem;
      margin-bottom: 6px;
    }

    .zv-fp-price-curr {
      font-size: 1.1rem;
    }

    .zv-fp-price-was {
      font-size: 0.85rem;
    }

    .zv-fp-overlay-actions {
      display: none; /* Tap card directly on mobile */
    }

    .zv-fp-all-btn {
      width: 100%;
      padding: 16px 24px;
      font-size: 0.98rem;
    }

    .zv-fp-cta-subtext {
      font-size: 0.8rem;
      gap: 8px;
    }
  }
</style>

<script>
  function filterHomeProducts(category, btn) {
    const bar = btn.closest('.zv-fp-filter-bar');
    if (bar) {
      bar.querySelectorAll('.zv-fp-filter-chip').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
    }

    const cards = document.querySelectorAll('.zv-fp-card');
    cards.forEach(card => {
      const cardCat = card.getAttribute('data-category');
      if (category === 'all' || cardCat === category) {
        card.style.display = 'flex';
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

{% schema %}
{
  "name": "ZV Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Tag",
      "default": "CURATED ESSENTIALS • AUTUMN / SPRING DROP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Menswear Drops"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered with breathable organic micro-ribbed knit, athletic tailoring, and vintage bohemian cords."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Maximum Products to Show"
    },
    {
      "type": "url",
      "id": "all_products_url",
      "label": "All Products Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE ALL PRODUCTS"
    }
  ],
  "presets": [
    {
      "name": "ZV Featured Collection"
    }
  ]
}
{% endschema %}
