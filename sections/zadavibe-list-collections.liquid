<section class="zv-categories-section">
  <!-- Banner Header -->
  <div class="zv-categories-banner">
    <div class="zv-container">
      <div class="zv-categories-banner-content">
        <span class="zv-hero-pill-badge" style="margin-bottom: 12px;">
          <span>✨</span> {{ section.settings.badge | default: "Curated Categories • Dubai Luxury" }}
        </span>
        <h1 class="zv-section-title" style="font-size: clamp(2rem, 3.8vw, 3.2rem); margin-bottom: 14px;">
          {{ section.settings.heading | default: "Explore Collections & Categories" }}
        </h1>
        <p class="zv-section-subtitle" style="max-width: 680px; margin: 0 auto 24px;">
          {{ section.settings.subheading | default: "From handcrafted vintage ribbed knits to luxury footwear and athletic silhouettes, discover premium menswear tailored for comfort across the UAE." }}
        </p>

        <!-- Quick Filter Links -->
        <div class="zv-categories-quick-pills">
          <a href="/collections/all" class="zv-cat-pill active">🔥 All Products</a>
          <a href="/collections/shoes" class="zv-cat-pill">👟 Shoes & Footwear</a>
          <a href="/collections/jeans" class="zv-cat-pill">👖 Jeans & Denim</a>
          {%- for col in collections -%}
            {%- unless col.handle == 'all' or col.handle == 'frontpage' or col.handle == 'shoes' or col.handle == 'jeans' -%}
              <a href="{{ col.url }}" class="zv-cat-pill">
                {{ col.title }}
              </a>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <!-- Collections Grid -->
  <div class="zv-categories-grid-wrap">
    <div class="zv-container">
      <div class="zv-categories-grid">
        {%- assign rendered_collections = false -%}

        {%- for collection in collections -%}
          {%- unless collection.handle == 'frontpage' -%}
            {%- assign rendered_collections = true -%}
            <div class="zv-category-card">
              <div class="zv-category-media">
                <a href="{{ collection.url }}" class="zv-category-img-link">
                  {%- if collection.featured_image -%}
                    <img
                      src="{{ collection.featured_image | image_url: width: 700 }}"
                      alt="{{ collection.title | escape }} - ZadaVibe UAE"
                      width="500"
                      height="600"
                      loading="lazy"
                      class="zv-category-img"
                    >
                  {%- elsif collection.products.first.featured_image -%}
                    <img
                      src="{{ collection.products.first.featured_image | image_url: width: 700 }}"
                      alt="{{ collection.title | escape }} - ZadaVibe UAE"
                      width="500"
                      height="600"
                      loading="lazy"
                      class="zv-category-img"
                    >
                  {%- elsif collection.handle contains 'shoe' -%}
                    <img
                      src="{{ 'zadavibe-model-hero.jpg' | asset_url }}"
                      alt="{{ collection.title | escape }} - Shoes & Footwear UAE"
                      width="500"
                      height="600"
                      loading="lazy"
                      class="zv-category-img"
                    >
                  {%- elsif collection.handle contains 'jean' or collection.handle contains 'denim' -%}
                    <img
                      src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}"
                      alt="{{ collection.title | escape }} - Jeans & Denim UAE"
                      width="500"
                      height="600"
                      loading="lazy"
                      class="zv-category-img"
                    >
                  {%- else -%}
                    <img
                      src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}"
                      alt="{{ collection.title | escape }} - Menswear UAE"
                      width="500"
                      height="600"
                      loading="lazy"
                      class="zv-category-img"
                    >
                  {%- endif -%}
                </a>

                <div class="zv-category-count-badge">
                  <span>{{ collection.all_products_count | default: 0 }} Styles</span>
                </div>
              </div>

              <div class="zv-category-body">
                <h3 class="zv-category-title">
                  <a href="{{ collection.url }}">{{ collection.title }}</a>
                </h3>
                <p class="zv-category-desc">
                  {%- if collection.description != blank -%}
                    {{ collection.description | strip_html | truncate: 90 }}
                  {%- elsif collection.handle contains 'shoe' -%}
                    Luxury leather footwear, sneakers, and slip-ons engineered for UAE gentlemen.
                  {%- elsif collection.handle contains 'jean' or collection.handle contains 'denim' -%}
                    Classic loose straight fit and dark washed vintage denim engineered for UAE gentlemen.
                  {%- else -%}
                    Breathable organic knits and vintage tailored designs with fast UAE delivery.
                  {%- endif -%}
                </p>

                <a href="{{ collection.url }}" class="zv-category-btn">
                  <span>EXPLORE COLLECTION</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          {%- endunless -%}
        {%- endfor -%}

        {%- unless rendered_collections -%}
          <!-- Fallback Visual Category Cards if store collections are still being setup in Shopify Admin -->
          <div class="zv-category-card">
            <div class="zv-category-media">
              <a href="/collections/all" class="zv-category-img-link">
                <img src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}" alt="Vintage Henleys" width="500" height="600" class="zv-category-img">
              </a>
              <div class="zv-category-count-badge"><span>12 Styles</span></div>
            </div>
            <div class="zv-category-body">
              <h3 class="zv-category-title"><a href="/collections/all">Signature Henleys & Knits</a></h3>
              <p class="zv-category-desc">Handcrafted vintage lace-up ribbed henleys in breathable organic cotton.</p>
              <a href="/collections/all" class="zv-category-btn">
                <span>EXPLORE COLLECTION</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <div class="zv-category-card">
            <div class="zv-category-media">
              <a href="/collections/shoes" class="zv-category-img-link">
                <img src="{{ 'zadavibe-model-hero.jpg' | asset_url }}" alt="Shoes & Footwear" width="500" height="600" class="zv-category-img">
              </a>
              <div class="zv-category-count-badge"><span>New Drop</span></div>
            </div>
            <div class="zv-category-body">
              <h3 class="zv-category-title"><a href="/collections/shoes">Shoes & Footwear</a></h3>
              <p class="zv-category-desc">Tailored leather loafers, modern sneakers, and comfort slip-ons for Dubai gentlemen.</p>
              <a href="/collections/shoes" class="zv-category-btn">
                <span>EXPLORE COLLECTION</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <div class="zv-category-card">
            <div class="zv-category-media">
              <a href="/collections/jeans" class="zv-category-img-link">
                <img src="{{ 'zadavibe-product-shirt.jpg' | asset_url }}" alt="Jeans & Denim" width="500" height="600" class="zv-category-img">
              </a>
              <div class="zv-category-count-badge"><span>Trending Drop</span></div>
            </div>
            <div class="zv-category-body">
              <h3 class="zv-category-title"><a href="/collections/jeans">Jeans & Denim</a></h3>
              <p class="zv-category-desc">Classic loose straight fit and dark washed vintage denim engineered for all-day comfort.</p>
              <a href="/collections/jeans" class="zv-category-btn">
                <span>EXPLORE COLLECTION</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        {%- endunless -%}
      </div>
    </div>
  </div>
</section>

<style>
  .zv-categories-section {
    background: #ffffff;
    padding-bottom: 80px;
  }

  .zv-categories-banner {
    background: linear-gradient(180deg, #fdfbf7 0%, #f4efe6 100%);
    padding: 60px 0 45px;
    text-align: center;
    border-bottom: 1px solid var(--zv-border);
  }

  .zv-categories-quick-pills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }

  .zv-categories-grid-wrap {
    padding: 50px 0;
  }

  .zv-categories-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px 24px;
  }

  .zv-category-card {
    background: #ffffff;
    border-radius: var(--zv-radius-md);
    border: 1px solid var(--zv-border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--zv-shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .zv-category-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--zv-shadow-md);
  }

  .zv-category-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--zv-bg-soft);
  }

  .zv-category-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .zv-category-card:hover .zv-category-img {
    transform: scale(1.08);
  }

  .zv-category-count-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(18, 20, 18, 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--zv-radius-pill);
    letter-spacing: 0.02em;
  }

  .zv-category-body {
    padding: 22px 20px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .zv-category-title {
    font-family: var(--zv-font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 8px;
  }

  .zv-category-title a {
    color: var(--zv-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .zv-category-title a:hover {
    color: var(--zv-accent);
  }

  .zv-category-desc {
    color: var(--zv-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 20px;
    flex: 1;
  }

  .zv-category-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--zv-bg-soft);
    color: var(--zv-primary);
    padding: 12px 20px;
    border-radius: var(--zv-radius-pill);
    font-family: var(--zv-font-heading);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    border: 1px solid var(--zv-border);
    transition: all 0.25s ease;
  }

  .zv-category-btn:hover {
    background: var(--zv-primary);
    color: #ffffff;
    border-color: var(--zv-primary);
  }

  @media (max-width: 992px) {
    .zv-categories-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 16px;
    }
  }

  @media (max-width: 640px) {
    .zv-categories-banner {
      padding: 36px 0 28px;
    }

    .zv-categories-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .zv-categories-quick-pills {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding: 4px 16px 8px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .zv-categories-quick-pills::-webkit-scrollbar {
      display: none;
    }

    .zv-category-media {
      aspect-ratio: 16 / 10;
    }

    .zv-category-body {
      padding: 18px 16px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "ZV Categories Directory",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Top Pill Badge",
      "default": "Curated Categories • Dubai Luxury"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Collections & Categories"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From handcrafted vintage ribbed knits to luxury footwear and athletic silhouettes, discover premium menswear tailored for comfort across the UAE."
    }
  ],
  "presets": [
    {
      "name": "ZV Categories Directory"
    }
  ]
}
{% endschema %}
