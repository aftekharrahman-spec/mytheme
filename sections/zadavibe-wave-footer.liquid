{% schema %}
{
  "name": "ZV Wave Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer Background Color",
      "default": "#2d3b31"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "ZADAVIBE"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand Bio",
      "default": "Crafting signature men’s apparel that fuses timeless vintage aesthetics with modern tailoring and all-day comfort."
    }
  ],
  "presets": [
    {
      "name": "ZV Wave Footer"
    }
  ]
}
{% endschema %}
