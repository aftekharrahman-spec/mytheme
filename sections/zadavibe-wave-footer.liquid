            </svg>
          </span>

          <!-- Apple Pay -->
          <span class="zv-payment-badge" title="Apple Pay">
            <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Apple Pay">
              <path fill="#ffffff" d="M12.9 10.3c-.4.5-1.1.9-1.7.9-.1 0-.3 0-.4-.1-.1-.8.2-1.6.6-2.1.4-.5 1.1-.9 1.7-.9.1 0 .3 0 .4.1 0 .8-.2 1.5-.6 2.1zm1.2 4.6c-.3.7-.8 1.6-1.4 2.4-.6.8-1.2 1.5-2 1.5-.8 0-1-.5-2-.5s-1.2.5-2 .5c-.8 0-1.4-.7-2-1.5-1.2-1.8-2.1-5-2.1-7.8 0-4.5 2.9-6.9 5.8-6.9 1.5 0 2.6.9 3.4.9.7 0 1.8-.9 3.5-.9 1.4 0 3 .7 3.9 2-2.7 1.6-2.3 5.4.3 6.6-.7 1.4-1.5 2.9-2.4 3.7h-.2zm6.4-9.3h3.5c1.8 0 3.2 1.2 3.2 2.9 0 1.8-1.4 2.9-3.2 2.9h-1.6v3.7h-1.9V5.6zm1.9 4.3h1.4c1 0 1.6-.6 1.6-1.4s-.6-1.4-1.6-1.4h-1.4v2.8zm7.1 5.3c0-1.4 1.1-2.2 3.1-2.3l1.8-.1v-.5c0-.8-.6-1.3-1.6-1.3-.9 0-1.5.4-1.7 1h-1.8c.2-1.5 1.6-2.4 3.5-2.4 2.1 0 3.4 1.1 3.4 2.9v4.9h-1.8v-1.1c-.6.8-1.6 1.3-2.6 1.3-1.4 0-2.3-.9-2.3-2.4zm4.9-.8v-.7l-1.6.1c-1 .1-1.5.5-1.5 1.1 0 .6.5 1 1.3 1 .9 0 1.8-.6 1.8-1.5zm6.3 3.9l1.9-5.6h2l-3.2 8.4h-1.9l1.2-3.1-2.8-5.3h2.1l1.7 3.6z"/>
