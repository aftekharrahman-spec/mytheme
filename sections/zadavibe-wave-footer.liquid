<footer class="zv-wave-footer" style="--zv-footer-bg: {{ section.settings.bg_color | default: '#2d3b31' }}; --zv-footer-text: {{ section.settings.text_color | default: '#ffffff' }};">
  {%- if section.settings.enable_wave_animation -%}
    <!-- River Wave Smooth Multi-layer Animation (Like Flowing River Water) -->
    <div class="zv-river-wave-wrap" aria-hidden="true">
      <svg class="zv-river-waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
        <defs>
          <path id="zv-river-curve" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
        </defs>
        <g class="zv-river-parallax">
          <use xlink:href="#zv-river-curve" x="48" y="0" class="zv-wave-layer zv-wave-1" />
          <use xlink:href="#zv-river-curve" x="48" y="3" class="zv-wave-layer zv-wave-2" />
          <use xlink:href="#zv-river-curve" x="48" y="5" class="zv-wave-layer zv-wave-3" />
          <use xlink:href="#zv-river-curve" x="48" y="7" class="zv-wave-layer zv-wave-4" />
        </g>
      </svg>
    </div>
  {%- endif -%}

  <div class="zv-container">
    <div class="zv-footer-main-grid">
      <!-- Col 1: Brand -->
      <div class="zv-footer-col zv-footer-brand-col">
        {%- if section.settings.brand_logo != blank -%}
          <img
            src="{{ section.settings.brand_logo | image_url: width: 300 }}"
            alt="{{ shop.name | escape }}"
            width="140"
            height="40"
            loading="lazy"
            style="max-width: 160px; height: auto; margin-bottom: 16px;"
          >
        {%- else -%}
          <h2 class="zv-footer-brand-title">{{ section.settings.brand_title | default: shop.name | default: 'ZADAVIBE' }}</h2>
        {%- endif -%}

        {%- if section.settings.brand_bio != blank -%}
          <p class="zv-footer-brand-bio">{{ section.settings.brand_bio }}</p>
        {%- endif -%}

        <!-- Brand Social Icons -->
        <div class="zv-footer-socials">
          <a href="{{ settings.social_instagram_link | default: '#' }}" class="zv-footer-social-link" title="Instagram" aria-label="Instagram">
            <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="{{ settings.social_tiktok_link | default: '#' }}" class="zv-footer-social-link" title="TikTok" aria-label="TikTok">
            <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.97v7.24c0 1.95-.51 3.9-1.57 5.53-1.07 1.63-2.6 2.87-4.41 3.52-1.81.65-3.8.64-5.6-.04-1.8-.68-3.32-1.99-4.32-3.66-1.01-1.67-1.44-3.66-1.22-5.61.22-1.95 1.12-3.77 2.54-5.14 1.42-1.37 3.28-2.21 5.25-2.38.38-.03.77-.04 1.16-.01v4.19c-.83-.1-1.68.04-2.42.42-.74.38-1.33.99-1.69 1.74-.36.75-.43 1.61-.2 2.43.23.82.74 1.52 1.45 1.98.71.46 1.56.66 2.4.56.84-.1 1.62-.51 2.19-1.15.57-.64.88-1.48.88-2.34V.02z"/></svg>
          </a>
          <a href="https://wa.me/971501234567" target="_blank" rel="noopener" class="zv-footer-social-link" title="WhatsApp Support" aria-label="WhatsApp">
            <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links (Dynamic Menu from Shopify Admin) -->
      <div class="zv-footer-col zv-footer-links-col">
        <h3 class="zv-footer-heading">{{ section.settings.quick_links_heading | default: 'Quick links' }}</h3>
        <ul class="zv-footer-nav-list">
          {%- assign footer_menu = linklists[section.settings.menu] -%}
          {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
            {%- for link in footer_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <!-- Default Essential Policy & Store Pages matching user's reference -->
            <li><a href="/search">Search</a></li>
            <li><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a></li>
            <li><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Refund Policy</a></li>
            <li><a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Shipping Policy</a></li>
            <li><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms of Service</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 3: Subscribe to our emails (Matching Screenshot Exactly) -->
      <div class="zv-footer-col zv-footer-newsletter-col">
        <h3 class="zv-footer-heading">{{ section.settings.newsletter_heading | default: 'Subscribe to our emails' }}</h3>
        
        {%- if section.settings.newsletter_subtext != blank -%}
          <p class="zv-newsletter-sub">{{ section.settings.newsletter_subtext }}</p>
        {%- endif -%}

        <div class="zv-newsletter-box">
          {% form 'customer', class: 'zv-sub-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="zv-sub-input-wrap">
              <input
                type="email"
                name="contact[email]"
                class="zv-sub-input"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Email' }}"
                required
                autocomplete="email"
                aria-label="{{ section.settings.newsletter_placeholder | default: 'Email' }}"
              >
            </div>
            <button type="submit" class="zv-sub-btn">
              {{ section.settings.newsletter_btn_label | default: 'Sign up' }}
            </button>
            
            {%- if form.posted_successfully? -%}
              <p class="zv-sub-message zv-sub-success">✓ Thank you for subscribing to ZadaVibe!</p>
            {%- elsif form.errors -%}
              <p class="zv-sub-message zv-sub-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {% endform %}
        </div>
      </div>
    </div>

    <!-- Bottom Bar & Copyright -->
    <div class="zv-footer-bottom-row">
      <p class="zv-footer-copy">
        {{ section.settings.copyright_text | default: '© 2026, ZadaVibe. Powered by Shopify' }}
      </p>

      {%- if section.settings.show_payment_icons -%}
        <div class="zv-payment-badges" aria-label="Accepted Payment Methods">
          <!-- Visa -->
          <span class="zv-payment-badge" title="Visa">
