<footer class="zv-wave-footer" style="background-color: {{ section.settings.bg_color }};">
  <div class="zv-wave-svg">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z" style="fill: {{ section.settings.bg_color }};"></path>
    </svg>
  </div>

  <div class="zv-container">
    <div class="zv-footer-grid">
      <!-- Brand & Socials -->
      <div class="zv-footer-brand">
        <h2>{{ section.settings.brand_title | default: 'ZADAVIBE' }}</h2>
        <p>{{ section.settings.brand_bio | default: 'Crafting signature men’s apparel that fuses timeless vintage aesthetics with modern tailoring and all-day comfort.' }}</p>
        
        <div style="display: flex; gap: 14px; margin-top: 20px;">
          <a href="#" style="width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: #fff; text-decoration: none;">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="#" style="width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: #fff; text-decoration: none;">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.97v7.24c0 1.95-.51 3.9-1.57 5.53-1.07 1.63-2.6 2.87-4.41 3.52-1.81.65-3.8.64-5.6-.04-1.8-.68-3.32-1.99-4.32-3.66-1.01-1.67-1.44-3.66-1.22-5.61.22-1.95 1.12-3.77 2.54-5.14 1.42-1.37 3.28-2.21 5.25-2.38.38-.03.77-.04 1.16-.01v4.19c-.83-.1-1.68.04-2.42.42-.74.38-1.33.99-1.69 1.74-.36.75-.43 1.61-.2 2.43.23.82.74 1.52 1.45 1.98.71.46 1.56.66 2.4.56.84-.1 1.62-.51 2.19-1.15.57-.64.88-1.48.88-2.34V.02z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="zv-footer-links">
        <h3>Collections</h3>
        <ul>
          <li><a href="/collections/all">All Men's Apparel</a></li>
          <li><a href="/collections/all">Signature Henleys</a></li>
          <li><a href="/collections/all">Ribbed Knitwear</a></li>
          <li><a href="/collections/all">New Season Drops</a></li>
          <li><a href="/collections/all">Bestsellers</a></li>
        </ul>
      </div>

      <!-- Customer Care -->
      <div class="zv-footer-links">
        <h3>Customer Care</h3>
        <ul>
          <li><a href="/pages/contact">Track Your Order</a></li>
          <li><a href="/pages/contact">Shipping & Delivery</a></li>
          <li><a href="/pages/contact">30-Day Returns</a></li>
          <li><a href="/pages/contact">Size & Fit Guide</a></li>
          <li><a href="/pages/contact">Help Center</a></li>
        </ul>
      </div>

      <!-- VIP Club Newsletter -->
      <div class="zv-footer-newsletter">
        <h3>VIP Club • Save 15%</h3>
        <p style="color: #c5cdc7; font-size: 0.9rem; margin-bottom: 12px;">Get exclusive member-only discounts, early drops, and menswear styling advice.</p>
        
        {% form 'customer', class: 'zv-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="zv-newsletter-input"
            value="{{ form.email }}"
            placeholder="Your email address"
            required
          >
          <button type="submit" class="zv-newsletter-btn">
            Join
          </button>
        {% endform %}
      </div>
    </div>

    <!-- Bottom Bar & Payment Icons -->
    <div class="zv-footer-bottom" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px;">
      <p style="margin: 0;">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Handcrafted with precision by Zadavibe Studio.</p>

      <div style="display: flex; gap: 10px; align-items: center;">
        <span style="background: rgba(255,255,255,0.15); padding: 4px 10px; border-radius: 4px; font-size: 0.72rem; font-weight: 700; color: #fff;">VISA</span>
        <span style="background: rgba(255,255,255,0.15); padding: 4px 10px; border-radius: 4px; font-size: 0.72rem; font-weight: 700; color: #fff;">MASTERCARD</span>
        <span style="background: rgba(255,255,255,0.15); padding: 4px 10px; border-radius: 4px; font-size: 0.72rem; font-weight: 700; color: #fff;">AMEX</span>
        <span style="background: rgba(255,255,255,0.15); padding: 4px 10px; border-radius: 4px; font-size: 0.72rem; font-weight: 700; color: #fff;">APPLE PAY</span>
        <span style="background: rgba(255,255,255,0.15); padding: 4px 10px; border-radius: 4px; font-size: 0.72rem; font-weight: 700; color: #fff;">GOOGLE PAY</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "ZV Wave Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer Background Color",
      "default": "#2d3b31"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "ZADAVIBE"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand Bio",
      "default": "Crafting signature men’s apparel that fuses timeless vintage aesthetics with modern tailoring and all-day comfort."
    }
  ],
  "presets": [
    {
      "name": "ZV Wave Footer"
    }
  ]
}
{% endschema %}
