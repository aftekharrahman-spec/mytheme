          </a>
          <a href="#" style="width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: #fff; text-decoration: none;">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.97v7.24c0 1.95-.51 3.9-1.57 5.53-1.07 1.63-2.6 2.87-4.41 3.52-1.81.65-3.8.64-5.6-.04-1.8-.68-3.32-1.99-4.32-3.66-1.01-1.67-1.44-3.66-1.22-5.61.22-1.95 1.12-3.77 2.54-5.14 1.42-1.37 3.28-2.21 5.25-2.38.38-.03.77-.04 1.16-.01v4.19c-.83-.1-1.68.04-2.42.42-.74.38-1.33.99-1.69 1.74-.36.75-.43 1.61-.2 2.43.23.82.74 1.52 1.45 1.98.71.46 1.56.66 2.4.56.84-.1 1.62-.51 2.19-1.15.57-.64.88-1.48.88-2.34V.02z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="zv-footer-links">
        <h3>Collections</h3>
        <ul>
          <li><a href="/collections/all">All Men's Apparel</a></li>
          <li><a href="/collections/all">Signature Henleys</a></li>
          <li><a href="/collections/all">Ribbed Knitwear</a></li>
          <li><a href="/collections/all">New Season Drops</a></li>
          <li><a href="/collections/all">Bestsellers</a></li>
        </ul>
      </div>

      <!-- Customer Care -->
      <div class="zv-footer-links">
        <h3>Customer Care</h3>
        <ul>
          <li><a href="/pages/contact">Track Your Order</a></li>
          <li><a href="/pages/contact">Shipping & Delivery</a></li>
          <li><a href="/pages/contact">30-Day Returns</a></li>
          <li><a href="/pages/contact">Size & Fit Guide</a></li>
          <li><a href="/pages/contact">Help Center</a></li>
        </ul>
      </div>

      <!-- VIP Club Newsletter -->
      <div class="zv-footer-newsletter">
        <h3>VIP Club • Save 15%</h3>
        <p style="color: #c5cdc7; font-size: 0.9rem; margin-bottom: 12px;">Get exclusive member-only discounts, early drops, and menswear styling advice.</p>
        
        {% form 'customer', class: 'zv-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="zv-newsletter-input"
            value="{{ form.email }}"
            placeholder="Your email address"
            required
          >
          <button type="submit" class="zv-newsletter-btn">
            Join
          </button>
        {% endform %}
      </div>
    </div>

    <!-- Bottom Bar & Payment Icons -->
    <div class="zv-footer-bottom">
      <p style="margin: 0;">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Handcrafted with precision by Zadavibe Studio.</p>

