<section class="zv-press-marquee-section" style="--zv-press-bg: {{ section.settings.bg_color | default: '#f8f6f2' }}; --zv-press-text: {{ section.settings.text_color | default: '#1a1d1b' }};">
  {%- if section.settings.heading != blank -%}
    <div class="zv-press-header">
      <span class="zv-press-tag">{{ section.settings.heading }}</span>
    </div>
  {%- endif -%}

  <div class="zv-press-marquee-container" id="zv-press-scroll-container">
    <div class="zv-press-marquee-track">
      <!-- Sequence 1 -->
      <div class="zv-press-sequence">
        <div class="zv-press-item">
          <svg class="zv-press-gq-svg" viewBox="0 0 76 32" height="26" fill="currentColor" aria-label="GQ">
            <path d="M26.2 3.5C21.8 1.1 16.2.2 10.6 1.4 3.7 2.9-.8 8.8.1 15.8.9 22.2 5.9 27.2 12.3 27.9c5.2.6 10.3-.9 14.1-4.2v-6.9H13.8v-4.5h17.1v13.6c-5.2 4.4-12.1 6.3-18.8 5.3C4.5 29.8-1.5 23.3-.4 15.3.6 7.1 6.5.7 14.7-.2c6.1-.7 12.1.8 16.8 4.2l-5.3 3.5z"/>
            <path d="M57.8 1.1c8.8 1.1 15.2 8.7 14.3 17.5-.8 7.6-6.2 13.5-13.8 14.7-4.1.6-8.2-.1-11.7-2l3.4-3.6c2.5 1.3 5.3 1.8 8.2 1.4 5.3-.8 9.3-5.2 9.7-10.5.5-6.5-4.2-12.3-10.7-12.8-6.1-.5-11.5 3.9-12.4 10-.7 4.9 1.5 9.7 5.7 12.2l-3.3 3.5c-5.4-3.3-8.2-9.6-7.2-15.9 1.1-7.8 7.7-13.7 15.6-14.4l2.5-.1zm-2.8 19.8l4.4-4.5 12.8 13.5-4.4 4.5L55 20.9z"/>
          </svg>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <span class="zv-press-esquire">Esquire</span>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <div class="zv-press-combo">
            <span class="zv-press-vogue">VOGUE</span>
            <span class="zv-press-sub">MAN</span>
          </div>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <span class="zv-press-hypebeast">HYPEBEAST</span>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <div class="zv-press-combo">
            <span class="zv-press-bazaar">BAZAAR</span>
            <span class="zv-press-sub">MEN</span>
          </div>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <span class="zv-press-menshealth">Men'sHealth</span>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <span class="zv-press-forbes">Forbes</span>
        </div>
        <div class="zv-press-sep">✦</div>
      </div>

      <!-- Sequence 2 (Duplicate for Seamless Infinite Loop) -->
      <div class="zv-press-sequence" aria-hidden="true">
        <div class="zv-press-item">
          <svg class="zv-press-gq-svg" viewBox="0 0 76 32" height="26" fill="currentColor" aria-label="GQ">
            <path d="M26.2 3.5C21.8 1.1 16.2.2 10.6 1.4 3.7 2.9-.8 8.8.1 15.8.9 22.2 5.9 27.2 12.3 27.9c5.2.6 10.3-.9 14.1-4.2v-6.9H13.8v-4.5h17.1v13.6c-5.2 4.4-12.1 6.3-18.8 5.3C4.5 29.8-1.5 23.3-.4 15.3.6 7.1 6.5.7 14.7-.2c6.1-.7 12.1.8 16.8 4.2l-5.3 3.5z"/>
            <path d="M57.8 1.1c8.8 1.1 15.2 8.7 14.3 17.5-.8 7.6-6.2 13.5-13.8 14.7-4.1.6-8.2-.1-11.7-2l3.4-3.6c2.5 1.3 5.3 1.8 8.2 1.4 5.3-.8 9.3-5.2 9.7-10.5.5-6.5-4.2-12.3-10.7-12.8-6.1-.5-11.5 3.9-12.4 10-.7 4.9 1.5 9.7 5.7 12.2l-3.3 3.5c-5.4-3.3-8.2-9.6-7.2-15.9 1.1-7.8 7.7-13.7 15.6-14.4l2.5-.1zm-2.8 19.8l4.4-4.5 12.8 13.5-4.4 4.5L55 20.9z"/>
          </svg>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <span class="zv-press-esquire">Esquire</span>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <div class="zv-press-combo">
            <span class="zv-press-vogue">VOGUE</span>
            <span class="zv-press-sub">MAN</span>
          </div>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <span class="zv-press-hypebeast">HYPEBEAST</span>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <div class="zv-press-combo">
            <span class="zv-press-bazaar">BAZAAR</span>
            <span class="zv-press-sub">MEN</span>
          </div>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <span class="zv-press-menshealth">Men'sHealth</span>
        </div>
        <div class="zv-press-sep">✦</div>

        <div class="zv-press-item">
          <span class="zv-press-forbes">Forbes</span>
        </div>
        <div class="zv-press-sep">✦</div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     ZadaVibe Luxury Menswear Press Marquee Ticker (News Feed Ribbon)
     ========================================================================== */
  .zv-press-marquee-section {
    padding: 22px 0 24px;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background-color: var(--zv-press-bg);
    color: var(--zv-press-text);
  }

  .zv-press-header {
    text-align: center;
    margin-bottom: 12px;
  }

  .zv-press-tag {
    font-family: var(--zv-font-heading, -apple-system, sans-serif);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--zv-press-text);
    opacity: 0.65;
  }

  .zv-press-marquee-container {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    display: flex;
    user-select: none;
    cursor: grab;
    mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 6%, rgba(0,0,0,1) 94%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 6%, rgba(0,0,0,1) 94%, rgba(0,0,0,0) 100%);
  }

  .zv-press-marquee-container::-webkit-scrollbar {
    display: none;
  }

  .zv-press-marquee-track {
    display: flex;
    white-space: nowrap;
    animation: zvPressFlow 25s linear infinite;
    will-change: transform;
    align-items: center;
  }

  .zv-press-marquee-container:hover .zv-press-marquee-track {
    animation-play-state: paused;
  }

  .zv-press-sequence {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .zv-press-item {
    padding: 6px 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--zv-press-text);
    transition: transform 0.25s ease, opacity 0.25s ease;
    opacity: 0.88;
  }

  .zv-press-item:hover {
    transform: scale(1.08);
    opacity: 1;
  }

  /* Typography for Authentic Publication Logos */
  .zv-press-gq-svg {
    display: block;
    height: 26px;
    width: auto;
  }

  .zv-press-esquire {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.85rem;
    font-weight: 700;
    font-style: italic;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .zv-press-combo {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    line-height: 1;
  }

  .zv-press-vogue {
    font-family: 'Playfair Display', 'Didot', 'Bodoni MT', serif;
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1;
  }

  .zv-press-bazaar {
    font-family: 'Playfair Display', 'Didot', 'Bodoni MT', serif;
    font-size: 1.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  .zv-press-sub {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    opacity: 0.85;
    position: relative;
    top: -2px;
  }

  .zv-press-hypebeast {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 1.4rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }

  .zv-press-menshealth {
    font-family: 'Impact', 'Arial Black', sans-serif;
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1;
  }

  .zv-press-forbes {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .zv-press-sep {
    font-size: 0.85rem;
    color: var(--zv-press-text);
    opacity: 0.4;
    margin: 0 4px;
    user-select: none;
  }

  @keyframes zvPressFlow {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .zv-press-marquee-section {
      padding: 16px 0 18px;
    }
    .zv-press-item {
      padding: 4px 20px;
    }
    .zv-press-gq-svg {
      height: 22px;
    }
    .zv-press-esquire {
      font-size: 1.5rem;
    }
    .zv-press-vogue,
    .zv-press-bazaar {
      font-size: 1.5rem;
    }
    .zv-press-hypebeast {
      font-size: 1.18rem;
    }
    .zv-press-menshealth {
      font-size: 1.25rem;
    }
    .zv-press-forbes {
      font-size: 1.4rem;
    }
    .zv-press-sep {
      font-size: 0.75rem;
      margin: 0 2px;
    }
  }
</style>

<script>
  (function() {
    const container = document.getElementById('zv-press-scroll-container');
    if (!container) return;

    let isDown = false;
    let startX;
    let scrollLeft;

    container.addEventListener('mousedown', (e) => {
      isDown = true;
      container.style.cursor = 'grabbing';
      startX = e.pageX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
    });

    container.addEventListener('mouseleave', () => {
      isDown = false;
      container.style.cursor = 'grab';
    });

    container.addEventListener('mouseup', () => {
      isDown = false;
      container.style.cursor = 'grab';
    });

    container.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - container.offsetLeft;
      const walk = (x - startX) * 2;
      container.scrollLeft = scrollLeft - walk;
    });
  })();
</script>

{% schema %}
{
  "name": "ZV Press Marquee Bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Top Label",
      "default": "AS SEEN IN GLOBAL MENSWEAR MEDIA"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f6f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1d1b"
    }
  ],
  "presets": [
    {
      "name": "ZV Press Marquee Bar"
    }
  ]
}
{% endschema %}
