<section class="zv-video-section">
  <div class="zv-container">
    <div class="zv-video-header">
      <div class="zv-video-tag">
        <span>🎬</span>
        <span>{{ section.settings.eyebrow | default: "CRAFTSMANSHIP IN MOTION" }}</span>
      </div>
      <h2 class="zv-video-title">{{ section.settings.heading | default: "Engineered For The Modern Gentleman" }}</h2>
      <p class="zv-video-subtitle">{{ section.settings.subheading | default: "Watch how our signature ribbed organic knit is woven, dyed, and tailored for effortless daily confidence." }}</p>
    </div>

    <div class="zv-video-wrapper">
      <div class="zv-video-frame" id="zv-video-frame-{{ section.id }}">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: image_size: '1200x', autoplay: false, loop: true, controls: true, muted: false, class: 'zv-native-video' }}
        {%- elsif section.settings.video_url != blank -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1&rel=0&playsinline=1"
              class="zv-iframe-video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              title="{{ section.settings.heading | escape }}"
            ></iframe>
          {%- elsif section.settings.video_url.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?badge=0&autopause=0&player_id=0&app_id=58479"
              class="zv-iframe-video"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              title="{{ section.settings.heading | escape }}"
            ></iframe>
          {%- endif -%}
        {%- elsif section.settings.mp4_url != blank -%}
          <video
            src="{{ section.settings.mp4_url }}"
            class="zv-native-video"
            poster="{{ section.settings.poster_image | image_url: width: 1200 }}"
            loop
            playsinline
            controls
          ></video>
        {%- else -%}
          <!-- Aesthetic Video Mockup Player (Click to play interactive luxury video experience) -->
          <div class="zv-video-fallback-player" id="zv-demo-player">
            {%- if section.settings.poster_image != blank -%}
              <img
                src="{{ section.settings.poster_image | image_url: width: 1200 }}"
                alt="Video Thumbnail"
                class="zv-video-poster-img"
              >
            {%- else -%}
              <img
                src="{{ 'zadavibe-model-hero.jpg' | asset_url }}"
                alt="Zadavibe Craftsmanship Preview"
                class="zv-video-poster-img"
                onerror="this.src='{{ 'zadavibe-product-shirt.jpg' | asset_url }}'"
              >
            {%- endif -%}

            <div class="zv-video-overlay-gradient"></div>

            <div class="zv-video-center-content">
              <button
                type="button"
                class="zv-video-play-btn"
                aria-label="Play Brand Video"
                onclick="zvPlayDemoVideo(this)"
              >
                <div class="zv-play-ring"></div>
                <div class="zv-play-icon-triangle">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="#ffffff">
                    <polygon points="6 3 20 12 6 21 6 3"></polygon>
                  </svg>
                </div>
              </button>

              <div class="zv-video-caption-box">
                <span class="zv-video-pill-live">WATCH FILM • 1:24 MIN</span>
                <h3 class="zv-video-caption-h3">The Secret Behind ZadaVibe Knits</h3>
              </div>
            </div>
          </div>
        {%- endif -%}

        <!-- Floating corner badge -->
        <div class="zv-video-float-tag">
          <span>🌿 100% Organic Fibers</span>
          <span>•</span>
          <span>⚡ Double-Ribbed Knit</span>
        </div>
      </div>

      <!-- 3 Feature Highlight Cards Under Video -->
      <div class="zv-video-features-row">
        <div class="zv-vf-card">
          <div class="zv-vf-icon">🧶</div>
          <div>
            <h4 class="zv-vf-title">Breathable Airflow</h4>
            <p class="zv-vf-desc">Natural micro-ribs create continuous air channels so heat and sweat escape effortlessly.</p>
          </div>
        </div>

        <div class="zv-vf-card">
          <div class="zv-vf-icon">👔</div>
          <div>
            <h4 class="zv-vf-title">Athletic Taper</h4>
            <p class="zv-vf-desc">Tailored across shoulders and chest while maintaining comfortable drape through waist.</p>
          </div>
        </div>

        <div class="zv-vf-card">
          <div class="zv-vf-icon">🛡️</div>
          <div>
            <h4 class="zv-vf-title">Pre-Shrunk Durability</h4>
            <p class="zv-vf-desc">Double-stitched hems and pre-washed cotton ensure fit and color never degrade.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .zv-video-section {
    padding: 75px 0 85px;
    background: #141a15;
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .zv-video-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 350px;
    background: radial-gradient(circle, rgba(192, 122, 80, 0.15) 0%, rgba(20, 26, 21, 0) 70%);
    pointer-events: none;
  }

  .zv-video-header {
    text-align: center;
    max-width: 660px;
    margin: 0 auto 36px;
    position: relative;
    z-index: 2;
  }

  .zv-video-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    padding: 6px 18px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
    color: #e5b08c;
    letter-spacing: 0.12em;
    margin-bottom: 14px;
  }

  .zv-video-title {
    font-family: var(--zv-font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    margin: 0 0 14px;
  }

  .zv-video-subtitle {
    font-family: var(--zv-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 1rem;
    color: #a3ac9e;
    line-height: 1.6;
    margin: 0;
  }

  .zv-video-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .zv-video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    background: #000000;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    border: 1.5px solid rgba(255, 255, 255, 0.12);
  }

  .zv-native-video,
  .zv-iframe-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
  }

  .zv-video-fallback-player {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .zv-video-poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .zv-video-fallback-player:hover .zv-video-poster-img {
    transform: scale(1.04);
  }

  .zv-video-overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(10,15,12,0.85) 100%);
    pointer-events: none;
  }

  .zv-video-center-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    z-index: 3;
    padding: 20px;
  }

  .zv-video-play-btn {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: rgba(192, 122, 80, 0.95);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 30px rgba(192, 122, 80, 0.5);
    transition: all 0.25s ease;
  }

  .zv-play-ring {
    position: absolute;
    inset: -10px;
    border: 2px solid rgba(192, 122, 80, 0.6);
    border-radius: 50%;
    animation: zvPlayPulse 2s infinite ease-out;
  }

  @keyframes zvPlayPulse {
    0% { transform: scale(0.9); opacity: 1; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  .zv-video-play-btn:hover {
    transform: scale(1.08);
    background: #d4895e;
  }

  .zv-play-icon-triangle {
    transform: translateX(2px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zv-video-caption-box {
    text-align: center;
  }

  .zv-video-pill-live {
    display: inline-block;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .zv-video-caption-h3 {
    font-family: var(--zv-font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .zv-video-float-tag {
    position: absolute;
    bottom: 16px;
    left: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(15, 22, 17, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #e5b08c;
    z-index: 4;
  }

  /* Video Feature Highlights */
  .zv-video-features-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 36px;
  }

  .zv-vf-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .zv-vf-card:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
    border-color: rgba(192, 122, 80, 0.4);
  }

  .zv-vf-icon {
    font-size: 1.6rem;
    background: rgba(192, 122, 80, 0.15);
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .zv-vf-title {
    font-family: var(--zv-font-heading, 'Outfit', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px;
  }

  .zv-vf-desc {
    font-family: var(--zv-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.86rem;
    color: #94a39b;
    line-height: 1.5;
    margin: 0;
  }

  /* Mobile responsiveness */
  @media (max-width: 820px) {
    .zv-video-section {
      padding: 44px 0 54px;
    }

    .zv-video-header {
      margin-bottom: 24px;
    }

    .zv-video-frame {
      border-radius: 14px;
      aspect-ratio: 16 / 10;
    }

    .zv-video-play-btn {
      width: 60px;
      height: 60px;
    }

    .zv-video-features-row {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 24px;
    }

    .zv-video-float-tag {
      display: none;
    }
  }
</style>

<script>
  function zvPlayDemoVideo(btn) {
    const player = document.getElementById('zv-demo-player');
    if (!player) return;
    
    // Smooth pulse response
    btn.style.transform = 'scale(0.9)';
    setTimeout(() => {
      btn.style.transform = 'scale(1)';
      // Replace with active playing video or scroll to collection
      window.location.href = '/collections/all';
    }, 200);
  }
</script>

{% schema %}
{
  "name": "ZV Video Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Tag",
      "default": "CRAFTSMANSHIP IN MOTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered For The Modern Gentleman"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch how our signature ribbed organic knit is woven, dyed, and tailored for effortless daily confidence."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-Hosted Video (MP4)"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo Video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "text",
      "id": "mp4_url",
      "label": "Direct MP4 File URL (Optional)"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Custom Video Thumbnail / Poster"
    }
  ],
  "presets": [
    {
      "name": "ZV Video Showcase"
    }
  ]
}
{% endschema %}
