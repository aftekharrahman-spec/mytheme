<div class="zv-ticker-wrapper" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="zv-ticker-track">
    {%- for i in (1..6) -%}
      <div class="zv-ticker-item">
        <span>FREE EXPRESS UAE DELIVERY OVER AED 150</span>
        <span class="zv-ticker-dot"></span>
        <span>100% SECURE ENCRYPTED CHECKOUT</span>
        <span class="zv-ticker-dot"></span>
        <span>SAME-DAY DISPATCH TO DUBAI & ABU DHABI</span>
        <span class="zv-ticker-dot"></span>
        <span>30-DAY RISK-FREE RETURNS</span>
        <span class="zv-ticker-dot"></span>
        <span>PREMIUM LUXURY CRAFTSMANSHIP</span>
        <span class="zv-ticker-dot"></span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "ZV Discount Ticker",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2d3b31"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "ZV Discount Ticker"
    }
  ]
}
{% endschema %}
