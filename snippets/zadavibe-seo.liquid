{% comment %}
  ==============================================================================
  ZadaVibe Senior SEO & UAE Search Dominance Suite
  Engineered for Top Google UAE (Dubai, Abu Dhabi, Sharjah) SERP Rankings
  - Comprehensive Geo-Targeting & Hreflang
  - OpenGraph & Twitter Card Meta
  - Schema.org JSON-LD (Organization, OnlineStore, WebSite, Product, FAQPage, BreadcrumbList)
  ==============================================================================
{% endcomment %}

{%- liquid
  assign uae_country = 'United Arab Emirates'
  assign uae_city = 'Dubai'
  assign uae_currency = 'AED'
  assign current_url = canonical_url | default: request.origin

  # Dynamic High-Converting SEO Title
  if request.page_type == 'index'
    assign seo_title = 'ZadaVibe Dubai™ | Premium Men’s Ribbed Knits & Vintage Henleys UAE'
  elsif request.page_type == 'product'
    assign prod_price_formatted = product.price | money_without_currency | strip
    assign seo_title = product.title | append: ' | ZadaVibe UAE (AED ' | append: prod_price_formatted | append: ')'
  elsif request.page_type == 'collection'
    assign seo_title = collection.title | append: ' | Luxury Menswear Collection Dubai - ZadaVibe UAE'
  elsif request.page_type == 'cart'
    assign seo_title = 'Your Shopping Bag | ZadaVibe Dubai (Free UAE Delivery Over AED 150)'
  else
    assign seo_title = page_title | append: ' &ndash; ZadaVibe UAE'
  endif

  # Dynamic High-CTR Meta Description for UAE
  if page_description != blank and page_description != shop.description
    assign seo_description = page_description | escape
  elsif request.page_type == 'index'
    assign seo_description = 'Shop ZadaVibe luxury menswear in UAE. Handcrafted vintage lace-up ribbed henleys and breathable knitwear. Fast express delivery to Dubai, Abu Dhabi, & all Emirates. Free shipping over AED 150.'
  elsif request.page_type == 'product'
    assign clean_product_desc = product.description | strip_html | truncate: 140
    assign seo_description = 'Buy ' | append: product.title | append: ' in UAE. 100% organic ribbed cotton, tailored athletic fit. Express shipping to Dubai & Abu Dhabi. ' | append: clean_product_desc
  elsif request.page_type == 'collection'
    assign seo_description = 'Explore ' | append: collection.title | append: ' at ZadaVibe UAE. Luxury ribbed henleys, lightweight knitwear, and modern tunics with fast doorstep delivery across the Emirates.'
  else
    assign seo_description = 'ZadaVibe UAE — High-performance luxury menswear. Breathable organic knits, lace-up collars, and modern tailored silhouettes. Fast delivery across Dubai and UAE.'
  endif
-%}

<!-- Core SEO & Search Indexing -->
<title>{{ seo_title }}</title>
<link rel="canonical" href="{{ current_url }}">
<meta name="description" content="{{ seo_description | escape }}">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

<!-- Regional Geo-Targeting for Google UAE (Dubai / Abu Dhabi) -->
<meta name="geo.region" content="AE-DU">
<meta name="geo.placename" content="Dubai, United Arab Emirates">
<meta name="geo.position" content="25.2048;55.2708">
<meta name="ICBM" content="25.2048, 55.2708">
<meta name="target-country" content="AE">
<meta name="coverage" content="United Arab Emirates">
<meta name="distribution" content="Global">
<meta name="rating" content="General">

<!-- Hreflang Language & Regional Alternates -->
<link rel="alternate" hreflang="en-ae" href="{{ current_url }}">
<link rel="alternate" hreflang="ar-ae" href="{{ current_url }}">
<link rel="alternate" hreflang="x-default" href="{{ current_url }}">

<!-- OpenGraph Protocol (Facebook, WhatsApp, LinkedIn, iMessage) -->
<meta property="og:site_name" content="ZadaVibe Dubai">
<meta property="og:url" content="{{ current_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:description" content="{{ seo_description | escape }}">
<meta property="og:locale" content="en_AE">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip }}">
  <meta property="product:price:currency" content="AED">
  <meta property="product:condition" content="new">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ seo_title | escape }}">
{%- else -%}
  <meta property="og:image" content="{{ 'zadavibe-model-hero.jpg' | asset_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}

<!-- Twitter / X Card Optimization -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | escape }}">
{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- else -%}
  <meta name="twitter:image" content="{{ 'zadavibe-model-hero.jpg' | asset_url }}">
{%- endif -%}

<!-- ==========================================================================
     JSON-LD STRUCTURED DATA (Schema.org Master Rich Results)
     ========================================================================== -->

<!-- 1. WebSite Schema & Google Sitelinks Searchbox -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ shop.url }}/#website",
  "name": "ZadaVibe Dubai",
  "url": "{{ shop.url }}",
  "inLanguage": "en-AE",
  "description": "Luxury Men's Ribbed Knits & Vintage Henleys in the United Arab Emirates",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

<!-- 2. Organization & OnlineStore Schema (Local UAE Business Signals) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "@id": "{{ shop.url }}/#organization",
  "name": "ZadaVibe",
  "legalName": "ZadaVibe Menswear Studio Dubai",
  "url": "{{ shop.url }}",
  "logo": {
    "@type": "ImageObject",
    "url": "{{ 'zadavibe-product-shirt.jpg' | asset_url }}",
    "width": "600",
    "height": "600"
  },
  "image": "{{ 'zadavibe-model-hero.jpg' | asset_url }}",
  "description": "ZadaVibe is a luxury menswear studio engineered in the UAE, specializing in organic micro-ribbed knits, vintage lace-up henleys, and modern athletic tailored tunics.",
  "priceRange": "AED 120 - AED 290",
  "currenciesAccepted": "AED",
  "paymentAccepted": "Credit Card, Visa, Mastercard, Apple Pay, Google Pay",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Dubai",
    "addressRegion": "Dubai",
    "addressCountry": "AE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "25.2048",
    "longitude": "55.2708"
  },
  "areaServed": [
    {
      "@type": "Country",
      "name": "United Arab Emirates"
    },
    {
      "@type": "City",
      "name": "Dubai"
    },
    {
      "@type": "City",
      "name": "Abu Dhabi"
    },
    {
      "@type": "City",
      "name": "Sharjah"
    }
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Service",
    "areaServed": "AE",
    "availableLanguage": ["en", "ar"]
  }
}
</script>

<!-- 3. BreadcrumbList Schema (Clean Navigation in Google SERP) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop.url }}"
    }
    {%- if request.page_type == 'collection' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ collection.title | escape }}",
      "item": "{{ canonical_url }}"
    }
    {%- elsif request.page_type == 'product' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "Collections",
      "item": "{{ shop.url }}/collections/all"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ product.title | escape }}",
      "item": "{{ canonical_url }}"
    }
    {%- elsif request.page_type == 'cart' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "Shopping Bag",
      "item": "{{ canonical_url }}"
    }
    {%- endif -%}
  ]
}
</script>

{%- if request.page_type == 'product' -%}
<!-- 4. Product & Merchant Offer Schema (Google Rich Snippets & Shopping Tab) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ canonical_url }}",
  {%- if product.featured_media -%}
    "image": [
      "https:{{ product.featured_media | image_url: width: 1200 }}"
    ],
  {%- endif -%}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
  "mpn": {{ product.id | json }},
  "brand": {
    "@type": "Brand",
    "name": "ZadaVibe"
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ canonical_url }}",
    "priceCurrency": "AED",
    "price": "{{ product.price | divided_by: 100.0 }}",
    "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "seller": {
      "@type": "Organization",
      "name": "ZadaVibe Dubai"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0.00",
        "currency": "AED"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "AE"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 1,
          "unitCode": "d"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 2,
          "unitCode": "d"
        }
      }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "AE",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "2480",
    "bestRating": "5",
    "worstRating": "1"
  }
}
</script>
{%- endif -%}

<!-- 5. FAQPage Schema (Google Rich Snippets Accordion in Search Results) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How fast is delivery across Dubai and the UAE?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ZadaVibe offers same-day order dispatch with express 1 to 2 business days courier delivery across all UAE Emirates (Dubai, Abu Dhabi, Sharjah, Ajman, Ras Al Khaimah, Fujairah, and Umm Al Quwain). All orders over AED 150 qualify for Free Express Delivery."
      }
    },
    {
      "@type": "Question",
      "name": "What payment methods are accepted in the UAE?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ZadaVibe accepts 100% secure, encrypted online payments via Visa, Mastercard, American Express, Apple Pay, and Google Pay in UAE Dirhams (AED)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the fabric composition of ZadaVibe henleys and knitwear?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ZadaVibe shirts are crafted from 100% pre-shrunk organic micro-ribbed cotton. The natural micro-channels allow continuous airflow, making them exceptionally breathable for the UAE climate."
      }
    },
    {
      "@type": "Question",
      "name": "What is ZadaVibe's exchange and return policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We provide a 30-day risk-free hassle-free size exchange and return policy across the United Arab Emirates. Size exchanges are coordinated smoothly via our dedicated WhatsApp concierge."
      }
    }
  ]
}
</script>
